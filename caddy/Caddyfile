# alfred-black — Caddy ingress.
#
# Static file. Caddy substitutes {$DOMAIN} / {$ACME_EMAIL} from the
# environment (set on the `caddy` service in docker-compose.yaml) at load
# time — no template rendering step.
#
# TLS: automatic Let's Encrypt via the HTTP-01 challenge. Each host gets its
# own certificate; no DNS API token is needed. Certs persist in the
# `caddy_data` volume — keep it across `docker compose down`/`up` or repeated
# restarts will hit Let's Encrypt rate limits.
#
# DNS: before `docker compose up -d`, point these A-records at the VM's
# public IP — `@` (apex), `plane`, `sure`, `vault`, `mcp`, `sms`, `voice`.
# Caddy self-heals ACME on retry, so a stale record only delays the
# first cert.

{
	email {$ACME_EMAIL}
}

# Apex — the Wasp React SPA (static, served by the web-client nginx).
# `wasp build` splits the app in two: the SPA is served here; its API
# server lives on api.<domain> below. Distinct hosts — no path-prefix
# ambiguity between client routes and server endpoints.
#
# EXCEPT: a small set of PUBLIC ctrl-api webhook paths must be reachable
# on the apex domain because third-party services (OMI, Plane, Vexa,
# arbitrary stream webhooks) compose their callback URLs from
# TENANT_BASE_URL which is the apex (e.g. https://home.alfred.black).
# Without this path-level handler, those requests would land on the SPA
# nginx and get a 405 (POST on a static-file server). These paths are
# also marked `isPublic` in ctrl-api's auth.ts — they validate via their
# own webhook tokens / HMAC signatures, not the master Bearer key.
{$DOMAIN} {
	encode zstd gzip

	# Public webhook paths → ctrl-api directly. Exact prefixes only;
	# anything else on the apex falls through to the SPA below.
	#
	# /api/v1/channels/email/inbound is included so AgentMail can POST
	# inbound emails to alfred-black directly. AgentMail does not sign
	# its webhooks (per their docs), so the handler validates a
	# shared-secret `?token=` query param against AGENTMAIL_WEBHOOK_TOKEN
	# baked into the URL configured in the AgentMail console.
	@public_webhooks {
		path /api/v1/streams/omi/* /api/v1/plane/webhook /api/v1/webhooks/plane/steward /api/v1/webhooks/vexa /api/v1/webhooks/in/* /api/v1/channels/email/inbound
	}
	handle @public_webhooks {
		reverse_proxy ctrl-api:3100
	}

	# Legacy AgentMail URL — the old SaaS exposed `/webhooks/agentmail`
	# (which proxied to the tenant ctrl-api over Tailscale). On alfred-black
	# we still see this URL in existing AgentMail console configurations,
	# so we transparently rewrite it to the canonical endpoint. The
	# ?token=... query string is preserved automatically by uri replace.
	@legacy_agentmail_webhook path /webhooks/agentmail
	handle @legacy_agentmail_webhook {
		uri replace /webhooks/agentmail /api/v1/channels/email/inbound
		reverse_proxy ctrl-api:3100
	}

	# Everything else — the Wasp SPA.
	handle {
		reverse_proxy web-client:80
	}
}

# API — the Wasp server (auth, operations, custom api routes).
api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Plane — self-hosted project management.
plane.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy plane-proxy:80
}

# Sure — self-hosted personal finance.
sure.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy sure-web:3000
}

# Vaultwarden — the secrets manager.
vault.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy vaultwarden:80
}

# MCP server — Claude Custom Connector endpoint.
mcp.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy mcp-server:8787
}

# SMS — Twilio inbound webhook endpoint for Hermes' SMS gateway adapter.
# Hermes' SMS adapter binds a SEPARATE listener on :8080 (SMS_WEBHOOK_PORT,
# distinct from the gateway API server on :18789). Twilio POSTs inbound SMS
# here; Hermes validates X-Twilio-Signature (HMAC-SHA1, post-PR #7933). In
# the Twilio console, set the number's "A MESSAGE COMES IN" webhook to
# `https://sms.{$DOMAIN}/webhooks/twilio`.
sms.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy hermes:8080
}

# Voice — Twilio Media Streams WebSocket endpoint for the voice-bridge.
# Hermes has no native phone-call adapter (upstream issue #409), so
# realtime audio bridges through a separate service that translates
# Twilio mulaw <-> OpenAI gpt-realtime. The bridge's :9000 listener
# accepts WSS upgrades on /voice/<tenantId>?sig=<hmac>. In the Twilio
# console, set the number's "A CALL COMES IN" webhook to a TwiML <Stream>
# pointing at `wss://voice.{$DOMAIN}/voice/<id>?sig=...`. Caddy auto-issues
# the LE cert + handles the WS upgrade transparently.
voice.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy voice-bridge:9000
}
