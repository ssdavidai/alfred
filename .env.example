# alfred-black — environment template.
#
#   1. cp .env.example .env
#   2. fill every value in the "USER MUST FILL" block below
#   3. ./scripts/bootstrap.sh   — generates every auto-secret into .env
#   4. docker compose up -d
#
# bootstrap.sh appends the auto-generated secrets; do not fill them by hand.

# ════════════════════════════════════════════════════════════════════
# USER MUST FILL — required. bootstrap.sh refuses to run until these are set.
# ════════════════════════════════════════════════════════════════════

# The apex domain alfred-black is served on. The web app lives at
# https://${DOMAIN}; sidecars at plane./sure./vault./mcp.${DOMAIN}.
# Point A-records for @ plane sure vault mcp at this VM before `up`.
DOMAIN=

# Contact email for Let's Encrypt certificate registration.
ACME_EMAIL=

# The principal's display name (shown across the dashboard).
OWNER_NAME=

# Anthropic API key — the primary model provider.
ANTHROPIC_API_KEY=

# OpenRouter API key — fallback / secondary model routing.
OPENROUTER_API_KEY=

# Composio API key — third-party tool/integration connections.
COMPOSIO_API_KEY=

# Composio webhook signing secret — OPTIONAL. Configure the webhook on
# Composio's dashboard pointing at
#   https://${DOMAIN}/api/v1/composio/webhook
# and paste the signing secret here. When set, ctrl-api enforces HMAC
# verification (Standard-Webhooks scheme: webhook-id / webhook-timestamp /
# webhook-signature headers; also tolerates `x-composio-signature` /
# `sha256=<hex>` as a fallback). When unset, ctrl-api accepts unsigned
# webhooks with a loud WARN — strictly so the connected_account.updated
# → ACTIVE flip still unblocks onboarding on tenants that haven't rotated
# in a secret yet. Set this in production.
COMPOSIO_WEBHOOK_SECRET=

# ════════════════════════════════════════════════════════════════════
# USER MUST FILL — optional. Leave blank to disable the feature.
# ════════════════════════════════════════════════════════════════════

# Hermes LLM models — bare OpenRouter model IDs (see openrouter.ai/models).
# Defaults are sane current picks; override if a model ID goes stale or you
# want a different one. main = user-facing chat; workers = background agents;
# heavy = Opus-class background reasoning (onboarding + chore heavy steps).
HERMES_MAIN_MODEL=x-ai/grok-4.3
HERMES_WORKERS_MODEL=openai/gpt-4.1-nano
HERMES_HEAVY_MODEL=anthropic/claude-opus-4-6

# Google OAuth — fully optional. Onboarding does NOT need it: with
# COMPOSIO_API_KEY set (required above), "Start onboarding" connects Gmail
# through Composio's managed Google OAuth — Composio's own verified app, so
# you create no Google Cloud client and do no Google app-verification.
# Set these two only if you want either:
#   1. the cosmetic "Sign in with Google" login button (email+password works
#      without it); or
#   2. to run onboarding's Gmail connect through your OWN Google client
#      (gmail.readonly scope) instead of Composio's managed flow. This needs
#      a Web-application OAuth client from console.cloud.google.com with the
#      redirect URI  https://api.${DOMAIN}/auth/google/callback  and Google's
#      verification for the gmail.readonly scope.
# If COMPOSIO_API_KEY is set, onboarding uses Composio regardless of these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SendGrid API key — transactional email (verification, password reset).
# Leave blank to disable email sending (signup still works via dev mode).
SENDGRID_API_KEY=

# Mailgun — the web app's configured email provider. The app boots even
# with placeholder values here, but verification / password-reset emails
# only deliver with a real key + domain. Get them at mailgun.com.
MAILGUN_API_KEY=placeholder-set-a-real-key-to-send-email
MAILGUN_DOMAIN=new.alfred.black

# Sure (personal finance) runs in the default stack. Its first-boot admin
# account is staged for the ACME_EMAIL address. Set false only if you also
# remove the sure-* services from docker-compose.yaml.
SURE_ENABLED=true

# The principal's primary email address. Load-bearing across the stack: the
# first-brief email sender + sender-allowlist, the cross-tenant ingest guard,
# and Sure's first-boot owner account all key off it. The code reads
# OWNER_EMAIL (compose mirrors it into ALFRED_OWNER_EMAIL too). Set this —
# leaving it blank fails the first-brief email open and the ingest guard
# fails open. (C9.)
OWNER_EMAIL=

# AgentMail — outbound email for Alfred (the first-brief email + the `self`
# email tool). ctrl-api (email.ts) reads these from the container env; without
# them every send returns "AGENTMAIL_API_KEY not configured" and the first
# brief never reaches the inbox. The inbox is normally provisioned by the SaaS
# host (web/agentmail.ts, AgentMail provisioning vars below) and the resulting
# inbox-scoped key + id are written here per tenant. Set them by hand only for
# a standalone (non-SaaS-provisioned) deployment. AGENTMAIL_INBOX_ADDRESS is
# optional (display From:). A JSON fallback at
# /mnt/encrypted/alfred/.agentmail-credentials.json is also honoured.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_INBOX_ADDRESS=
#
# AgentMail provisioning (SaaS host / web app only — NOT a tenant .env value).
# These let web/agentmail.ts create a per-tenant inbox under a shared pod and
# verify inbound webhooks. Leave blank on a tenant VM; set on the SaaS host:
#   AGENTMAIL_ENABLED=true
#   AGENTMAIL_MASTER_API_KEY=     # master key that owns the shared pod
#   AGENTMAIL_SHARED_POD_ID=      # pod the per-tenant inboxes are created in
#   AGENTMAIL_DOMAIN=mail.alfred.black
#   AGENTMAIL_WEBHOOK_SECRET=     # svix-style secret verifying inbound mail

# OMI ambient transcription — the OmiAudioProcessorWorkflow (alfred-learn)
# transcribes captured wearable audio via Groq Whisper. Without a key every
# audio group is discarded as "empty transcription" and OMI capture is dead.
# Get a key at console.groq.com. Leave blank to disable OMI transcription.
GROQ_API_KEY=

# Signal pipeline (#78) — turns inbound stream events (email, etc.) into
# decision cards on the Desk. SignalExtract reads ingest.db (Store 4),
# extracts signals into state.db, and SignalRouter routes them to
# needs_attention cards / decisions. Both default ON for a working Desk.
# Set either to false to pause that stage (e.g. while debugging cost).
STEWARD_SIGNAL_EXTRACT_ENABLED=true
STEWARD_SIGNAL_ROUTER_ENABLED=true

# Host filesystem path of the compose dir (the dir holding THIS .env and
# docker-compose.yaml). Bind-mounted into ctrl-api at /srv/alfred-black so it
# can read/write .env (provider-key model catalog, credential
# writes) and shell out to `docker compose`. Default suits the merged
# single-VM layout; override only if you deploy the stack elsewhere.
COMPOSE_DIR_HOST=/opt/alfred

# The tenant's public base URL (https://<domain>). ctrl-api composeWebhookUrl()
# uses it to build absolute OMI / custom-webhook endpoint URLs; unset → the
# device/webhook URL comes back null and the integration is unusable. Defaults
# to https://${DOMAIN}; only set this explicitly if the tenant is served on a
# host that differs from DOMAIN.
TENANT_BASE_URL=https://${DOMAIN}

# SaaS host base URL — ctrl-api's generic (non-OMI) webhook URL composition
# falls back to this when TENANT_BASE_URL is absent. The code default was the
# wrong cross-tenant https://alfred.black; compose pins it to this tenant's own
# host. Override only for a multi-host SaaS deployment.
SAAS_HOST=https://${DOMAIN}

# Tailscale (off by default — turn on via /connections card). Issue #109.
# When TAILSCALE_ENABLED=true (set by the operator), the principal can flip
# the Tailscale card on /connections to start the sidecar
# (`docker compose --profile tailscale up -d tailscale`) and approve the
# device on login.tailscale.com once. The sidecar joins the principal's own
# tailnet; the public *.alfred.black hostname keeps working unchanged.
# PR 1 ships only the compose foundation — the routes (PR 2), card (PR 3),
# and Caddy/Serve outbound (PR 4) come next. See docs/specs/issue-109-*.md.
TAILSCALE_ENABLED=false
# Optional — path A (pre-shared auth-key) bootstrap. Leave blank to use
# path C (device-style auth URL), which is the recommended flow.
TAILSCALE_AUTHKEY=
# Tailnet device hostname. Blank → bootstrap.sh derives it from $DOMAIN
# with dots replaced by dashes (e.g. home.alfred.black → home-alfred-black).
# Compose's variable interpolation does not support Bash-style
# ${VAR//./-}, so the derivation happens in bootstrap.sh.
TAILSCALE_HOSTNAME_PREFIX=
# Comma-separated --advertise-tags passed to `tailscale up`. Blank by
# default (no tag advertised). Set to e.g. "tag:alfred-tenant" only if the
# operator has declared the tag in the principal's tailnet ACL.
TAILSCALE_TAGS=

# ════════════════════════════════════════════════════════════════════
# AUTO-GENERATED — managed by scripts/bootstrap.sh. Do not edit by hand.
# bootstrap.sh appends each of these with `openssl rand -hex 32` if missing
# and never overwrites an existing non-empty value.
# ════════════════════════════════════════════════════════════════════

# Composio per-install user-id that scopes this install's connected accounts.
# bootstrap.sh fills it with a readable `alfred-owner-<rand>` (NOT a
# rand-hex-32 secret). Required for onboarding's "connect Gmail" flow; ctrl-api
# rejects it if empty, and it must never be the literal "default".
#COMPOSIO_USER_ID=

# ctrl-api bearer key — shared between web → ctrl-api and mcp-server.
#AAS_API_KEY=

# AES-256-GCM key for OAuthCredential token encryption at rest.
#COLUMN_ENCRYPTION_KEY=

# Wasp session JWT signing secret.
#JWT_SECRET=

# Hermes gateway API-server key (both profiles share this token).
#HERMES_API_SERVER_KEY=

# Postgres password for the Wasp web app database (web-db).
#WEB_DATABASE_PASSWORD=

# Vaultwarden /admin token.
#VAULTWARDEN_ADMIN_TOKEN=

# mcp-server tool-approval signing secret.
#MCP_APPROVAL_SECRET=

# Plane — Django secret, datastore credentials, live-server secret.
#DJANGO_SECRET_KEY=
#POSTGRES_PASSWORD=
#REDIS_PASSWORD=
#MINIO_ROOT_PASSWORD=
#LIVE_SERVER_SECRET_KEY=

# Sure — Rails secret + datastore credentials.
#SURE_SECRET_KEY_BASE=
#SURE_POSTGRES_PASSWORD=
#SURE_REDIS_PASSWORD=
# Sure API key (64-char hex, == Sure's SecureRandom.hex(32) format). Bridges
# the integration: sure-init seeds this exact value into Sure's DB and ctrl-api
# reads it from SURE_API_KEY env, so the REST proxy stops returning
# NOT_CONFIGURED. Generated by bootstrap.sh.
#SURE_API_KEY=

# Paperclip — AI-agent orchestration plane ("the company").
# API token Hermes uses to call the Paperclip REST API. NOT
# auto-generated — Paperclip's better-auth issues keys through its own UI.
# After first signup at https://paperclip.<DOMAIN>, generate a key
# (Settings → API keys) and paste it here, then `docker compose restart
# hermes` so the MCP server picks it up.
#PAPERCLIP_API_KEY=
# Required by Paperclip's better-auth lib for session/token signing.
# Auto-generated by scripts/bootstrap.sh.
#PAPERCLIP_BETTER_AUTH_SECRET=
# HMAC secret Paperclip's HTTP adapter signs heartbeats with; ctrl-api
# validates inbound /api/v1/channels/paperclip/* requests against it.
# Auto-generated by scripts/bootstrap.sh.
#PAPERCLIP_HEARTBEAT_SECRET=

# ── Full-seed marker tuple — auto-populated by paperclip-init step 11b ──
# bootstrap-paperclip.sh runs after the paperclip container is healthy,
# claims the CEO invite headlessly, creates company "Alfred" + agent
# "hermes", mints a runtime token, and writes the three values below
# into this .env. ctrl-api reads PAPERCLIP_AGENT_TOKEN as the
# authoritative "ready" marker on the /channels Paperclip card. Do NOT
# set by hand — they appear automatically once the seed has run.
#PAPERCLIP_AGENT_TOKEN=
#PAPERCLIP_AGENT_ID=
#PAPERCLIP_COMPANY_ID=
# Optional overrides for the headless seed (defaults in parens):
#   PAPERCLIP_SEED_EMAIL   (alfred@${DOMAIN})
#   PAPERCLIP_SEED_NAME    (Alfred)
#   PAPERCLIP_SEED_COMPANY (Alfred)
#PAPERCLIP_SEED_EMAIL=
#PAPERCLIP_SEED_NAME=
#PAPERCLIP_SEED_COMPANY=

# Recall.ai — meeting bot SaaS (#113). Replaces the retired Vexa stack.
# RECALL_BOT_NAME is the display name Recall surfaces to other meeting
# participants when the bot joins. RECALL_REGION pins the Recall API
# region the bot is dispatched in — must match the region your Recall
# account is provisioned in (`us-east-1` / `us-west-2` / `eu-central-1`
# / `ap-northeast-1`). RECALL_WEBHOOK_SECRET is the Svix signing secret
# Recall presents on /api/v1/webhooks/recall — required for the inbound
# webhook to verify; leave blank to disable the webhook receiver. The
# API key itself is pasted on the /channels Recall card (PR3a) and
# written to RECALL_API_KEY by the card POST handler — do NOT set by
# hand below.
RECALL_BOT_NAME="Alfred's note-taker"
RECALL_REGION=us-east-1
RECALL_WEBHOOK_SECRET=
#RECALL_API_KEY=
