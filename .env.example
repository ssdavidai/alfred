# Hetzner Cloud API token (read/write)
HETZNER_API_TOKEN=

# Tailscale API key (for generating auth keys)
TAILSCALE_API_KEY=

# Tailscale tailnet name (e.g., "tail1234.ts.net")
TAILSCALE_TAILNET=

# Optional: OpenRouter API key (deployed to instances for free model access)
# Users can add their own API keys later via the instance's config
OPENROUTER_API_KEY=

# Hetzner Object Storage S3 credentials (for restic backups)
# Create at: Hetzner Console → Security → S3 Credentials
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_BUCKET=alfred-backups
HETZNER_S3_ENDPOINT=fsn1.your-objectstorage.com

# Alert webhook (Slack or Discord)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=slack

# Cloudflare Tunnel configuration
# Use either API Token (recommended) or Global API Key + Email
CLOUDFLARE_API_TOKEN=
# --- OR ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
# --- Required ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=alfred.black

# Admin SSH CIDRs for firewall (comma-separated, default: 0.0.0.0/0,::/0)
# Restrict to your admin IPs for production: e.g., 138.199.236.244/32
ADMIN_SSH_CIDRS=

# Optional: default Hetzner server type and location
DEFAULT_SERVER_TYPE=cx33
DEFAULT_LOCATION=fsn1
