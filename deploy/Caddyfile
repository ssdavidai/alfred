alfred.black {
    root * /opt/alfred-saas/client
    @voice {
        path /voice/*
    }
    @backend {
        path /api/* /auth/* /operations/* /jobs/* /payments/* /webhooks/*
    }
    handle @voice {
        # AgentPhone Voice Bridge — WebSocket upgrade for Twilio Media Streams
        reverse_proxy localhost:9000
    }
    handle @backend {
        reverse_proxy localhost:3000
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}

app.alfred.black {
    @get method GET HEAD OPTIONS
    handle @get {
        redir https://alfred.black{uri} permanent
    }
    handle {
        reverse_proxy localhost:3000
    }
}

plausible.alfred.black {
    reverse_proxy localhost:8000
}

voice.alfred.black {
    # Dedicated host for AgentPhone Voice Bridge WebSocket upgrade.
    #
    # MUST be DNS-only (grey cloud) at Cloudflare — proxied hostnames make
    # Cloudflare's WAF drop Twilio Media Stream WS upgrades with error 31920.
    # See deploy/AGENTPHONE_ROLLOUT.md for the DNS + TLS setup.
    reverse_proxy localhost:9000
}
