  entities: []
}

query getVaultRecords {
  fn: import { getVaultRecords } from "@src/dashboard/operations",
  entities: []
}

query getVaultRecord {
  fn: import { getVaultRecord } from "@src/dashboard/operations",
  entities: []
}

// XC #873 — title-index for live wikilink resolution in the Markdown
// component. Wraps tenant ctrl-api GET /api/v1/vault/index (60s in-memory
// cached on the tenant side).
query getVaultTitleIndex {
  fn: import { getVaultTitleIndex } from "@src/dashboard/operations",
  entities: []
}

// /files — principal-facing blob store (#114 PR3). Read endpoints flow
// through standard Wasp queries; upload + blob (multipart / raw bytes)
// ride through src/server/filesProxy.ts (registered in setup.ts).
query getFilesUsage {
  fn: import { getFilesUsage } from "@src/dashboard/operations",
  entities: []
}

query getFilesList {
  fn: import { getFilesList } from "@src/dashboard/operations",
  entities: []
}

query getFileStat {
  fn: import { getFileStat } from "@src/dashboard/operations",
  entities: []
}

action updateFileLabel {
  fn: import { updateFileLabel } from "@src/dashboard/operations",
  entities: []
}

action deleteFile {
  fn: import { deleteFile } from "@src/dashboard/operations",
  entities: []
}

// #114 §7+§8 — Recycle-bin view + symmetric restore.
//
// `listDeletedFiles` powers the "Recently deleted" expander on /files,
// surfacing soft-deleted rows whose tombstone falls inside the 30-day
// restore window. `restoreFile` clears the tombstone (atomically, with
// `file_blobs.ref_count` bumped back up) and writes a `file_restore`
// row to the audit ledger via appendAudit — the inverse undo recipe
// points back at DELETE so /study#audit reads the two-event story
// cleanly.
query listDeletedFiles {
  fn: import { listDeletedFiles } from "@src/dashboard/operations",
  entities: []
}

action restoreFile {
  fn: import { restoreFile } from "@src/dashboard/operations",
  entities: []
}

// STATE-MUTATION Phase E (#893) — briefings index + single. Wraps the
// ctrl-api endpoints written by the alfred-learn BriefingWorkflow.
// Powers /brief (most-recent) and /briefings (chronological list).
query getBriefings {
  fn: import { getBriefings } from "@src/briefings/operations",
  entities: []
}

query getBriefing {
  fn: import { getBriefing } from "@src/briefings/operations",
  entities: []
}

// Account-level "I have read this briefing" pointer. Stored on the User
// row (lastDismissedBriefingSlugDate). /desk shows the brief envelope
// only when the most-recent briefing.slug_date differs from this.
query getLastDismissedBriefing {
  fn: import { getLastDismissedBriefing } from "@src/briefings/operations",
  entities: [User]
}

action dismissBriefing {
  fn: import { dismissBriefing } from "@src/briefings/operations",
  entities: [User]
}

// M4 #859 — matters aggregator. The /matters index + /matters/:id
// detail surfaces, plus the /household placeholder backfill. Both
// queries proxy to the new GET /api/v1/matters[/<id>] endpoints in
// ctrl-api. Note: the existing tasks/operations.ts already exports
// a `getMatters` wrapping a triage-style endpoint — we use a distinct
// dashboard.getMatters here that hits the new /api/v1/matters route.
// To avoid Wasp name collision, this query is named `getMattersIndex`
// and the detail is `getMatterDetail`.
query getMattersIndex {
  fn: import { getMattersIndex } from "@src/dashboard/operations",
  entities: []
}

query getMatterDetail {
  fn: import { getMatterDetail } from "@src/dashboard/operations",
  entities: []
}

// RFC #884 — living-narrative per-chore detail. Distinct from `getChoreSource`
// (which returns generated Python). Returns current_state + as_of + timeline
// keyed off a task vault record.
query getChoreDetail2 {
  fn: import { getChoreDetail2 } from "@src/dashboard/operations",
  entities: []
}

query getVaultGraph {
  fn: import { getVaultGraph } from "@src/dashboard/operations",
  entities: []
}

query getNebulaData {
  fn: import { getNebulaData } from "@src/dashboard/operations",
