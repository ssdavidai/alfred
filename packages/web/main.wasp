route BriefingsRoute { path: "/briefings", to: BriefingsPage }
page BriefingsPage {
  authRequired: true,
  component: import BriefingsPage from "@src/briefings/BriefingsPage"
}

// /settings — unified back office (M6 #867 + #868; renamed from /study, F83).
// Canonical settings home. /study and /back-office redirect here.
route SettingsRoute { path: "/settings", to: StudyPage }
page StudyPage {
  authRequired: true,
  component: import StudyPage from "@src/dashboard/StudyPage"
}

// Legacy /study redirect (F83 — canonical home is now /settings).
route StudyRoute { path: "/study", to: StudyRedirectPage }
page StudyRedirectPage {
