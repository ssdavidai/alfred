}

route LogsRoute { path: "/dashboard/logs", to: LogsPage }
page LogsPage {
  authRequired: true,
  component: import LogsPage from "@src/dashboard/LogsPage"
}

route WorkspaceRoute { path: "/dashboard/workspace", to: WorkspacePage }
page WorkspacePage {
  authRequired: true,
  component: import WorkspacePage from "@src/dashboard/WorkspacePage"
}

// Legacy /dashboard/settings — redirects to the canonical /settings (F83;
// renamed from SettingsRoute to free that name for the canonical route).
route LegacyDashSettingsRoute { path: "/dashboard/settings", to: SettingsPage }
page SettingsPage {
  authRequired: true,
  component: import SettingsPage from "@src/dashboard/SettingsPage"
}

route ApiDocsRoute { path: "/dashboard/api-docs", to: ApiDocsPage }
page ApiDocsPage {
  authRequired: true,
