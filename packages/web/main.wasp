// ============================================================
// State-mutation observability (#897 Phase I)
// ============================================================
//
// Wraps the ctrl-api endpoints shipped in Phase A (#889):
//   GET /api/v1/state-changes          — cross-target feed
//   GET /api/v1/state-changes/sources  — 30-day source histogram
//   GET /api/v1/cron/preview           — next-N firing times for a cron
//
// Powers /decisions State Changes tab, /matters/:id timeline expansion,
// /chores/:slug Schedule editor, and /admin observability panels.

query getStateChanges {
  fn: import { getStateChanges } from "@src/state/operations",
  entities: []
}

query getStateChangeSources {
  fn: import { getStateChangeSources } from "@src/state/operations",
  entities: []
}

query getChoreScheduleFires {
  fn: import { getChoreScheduleFires } from "@src/state/operations",
  entities: []
}

// Manual vault edits to matter/task state fields flow through this action
// (Phase F · #894). Sends a POST /api/v1/state-changes envelope to ctrl-api
// with source=manual.<currentUserId>; the principal supplies an optional
// reason which is persisted into both the timeline entry and the audit
// record. Non-state-field edits continue to use the legacy PATCH path
// (updateTask / createVaultRecord upsert) — this action is only for the
// declared state-field allowlist on matter/* and task/* records.
action applyManualStateChange {
  fn: import { applyManualStateChange } from "@src/state/operations",
  entities: []
}

// Patch a chore record's mutable fields (schedule / name / description /
// python_source / etc.). Wraps PATCH /api/v1/chores/:slug. The Schedule
// editor on /chores/:slug only ever patches the `schedule` field.
action patchChore {
  fn: import { patchChore } from "@src/chores/operations",
  entities: []
}

