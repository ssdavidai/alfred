// Inbound custom-webhook endpoints — first-class stream sources alongside
// Composio toolkits + Omi. Each row is a private URL the principal POSTs
// arbitrary JSON to; each POST lands as a stream_event for the curator.
action createInboundWebhook {
  fn: import { createInboundWebhook } from "@src/integrations/operations",
  entities: []
}

action deleteInboundWebhook {
  fn: import { deleteInboundWebhook } from "@src/integrations/operations",
  entities: []
}

// F59 — OMI device pairing: creates-or-reuses the source:"omi" stream and
// returns its composed device webhook_url. Never touches Composio.
action pairOmiDevice {
  fn: import { pairOmiDevice } from "@src/integrations/operations",
  entities: []
}

// Reconciler — closes the gap between "Composio reports ACTIVE" and
// "tenant has its stream/skill/schedule wired up". Runs every minute and
// picks up any ComposioConnection where Composio is ACTIVE but our
// auto-config state is `pending` or `error` (with backoff). See
// reconcileWorker.ts for the full rationale; this exists because the
// frontend auto-fire effect in IntegrationsPage breaks down whenever the
// user closes the popup or navigates away mid-OAuth.
job reconcileComposioAutoConfig {
  executor: PgBoss,
  perform: {
    fn: import { reconcileComposioAutoConfigJob } from "@src/integrations/reconcileWorker"
  },
  schedule: {
    cron: "*/1 * * * *"
  },
  entities: [ComposioConnection, User]
}

