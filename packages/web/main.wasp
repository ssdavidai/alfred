}

route ComposingRoute { path: "/composing", to: ComposingPage }
page ComposingPage {
  authRequired: true,
  component: import ComposingPage from "@src/onboarding/ComposingPage"
}

route PreparingRoute { path: "/preparing", to: PreparingPage }
page PreparingPage {
