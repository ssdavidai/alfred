# syntax=docker/dockerfile:1
# =============================================================================
# alfred-web-client — serves the Wasp React SPA (the dashboard UI).
#
# `wasp build` produces TWO artefacts: the server (packaged by the generated
# .wasp/build/Dockerfile → the alfred-web image) and the client — a Vite
# React app at .wasp/build/web-app/. This image builds that client and serves
# the static bundle via nginx with SPA history-fallback.
#
# The API base URL is inlined by Vite at build time, so the client is built
# with a placeholder (__ALFRED_API_URL__); the nginx entrypoint substitutes
# the real URL ($WASP_SERVER_URL) at container start — the image stays
# domain-agnostic and `docker compose up` never has to build.
#
# Build context: packages/web (so .wasp/build/ is reachable after `wasp build`).
# =============================================================================
FROM node:22-slim AS build
WORKDIR /web-app
COPY .wasp/build/web-app/ ./
ENV REACT_APP_API_URL=__ALFRED_API_URL__
RUN npm install --no-audit --no-fund \
  && npm run build \
  && test -d build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /web-app/build /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
# nginx:alpine runs every executable /docker-entrypoint.d/*.sh before starting
# nginx — drop the API-URL substitution there.
COPY web-client-entrypoint.sh /docker-entrypoint.d/99-alfred-api-url.sh
RUN chmod +x /docker-entrypoint.d/99-alfred-api-url.sh
EXPOSE 80
