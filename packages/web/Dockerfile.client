# syntax=docker/dockerfile:1
# =============================================================================
# alfred-web-client — serves the Wasp React SPA (the dashboard UI).
#
# `wasp build` emits the client separately from the server. The client is an
# npm-workspace Vite project; it is built on the CI runner (see build-web.yml
# — "Build the Wasp SPA client"), where the Wasp toolchain resolves natively.
# This image only PACKAGES the static output — no build step here, so the
# multi-arch build is trivial.
#
# The API base URL is inlined by Vite with an __ALFRED_API_URL__ placeholder;
# the nginx entrypoint substitutes the real URL ($WASP_SERVER_URL) at
# container start, keeping the image domain-agnostic.
#
# Build context: packages/web — `web-app-build/` is the staged static bundle.
# =============================================================================
FROM nginx:1.27-alpine
COPY web-app-build/ /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
# nginx:alpine runs every executable /docker-entrypoint.d/*.sh before nginx.
COPY web-client-entrypoint.sh /docker-entrypoint.d/99-alfred-api-url.sh
RUN chmod +x /docker-entrypoint.d/99-alfred-api-url.sh
EXPOSE 80
