}

route TerminalRoute { path: "/dashboard/terminal", to: TerminalPage }
page TerminalPage {
  authRequired: true,
  component: import TerminalPage from "@src/dashboard/TerminalPage"
}

// API Key management
query listApiKeys {
  fn: import { listApiKeys } from "@src/apikeys/operations",
  entities: [ApiKey]
}

action createApiKey {
  fn: import { createApiKey } from "@src/apikeys/operations",
  entities: [ApiKey]
}

action revokeApiKey {
  fn: import { revokeApiKey } from "@src/apikeys/operations",
  entities: [ApiKey]
}

// User API proxy (Bearer token auth with user API keys)
api userApiProxy {
  fn: import { userApiProxy } from "@src/apikeys/proxy",
  entities: [ApiKey, Instance],
  middlewareConfigFn: import { apiProxyMiddleware } from "@src/apikeys/proxy",
  httpRoute: (ALL, "/user-api")
}

