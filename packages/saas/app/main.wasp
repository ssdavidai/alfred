// ============================================================
// Monitoring & Operations
// ============================================================
job healthMonitor {
  executor: PgBoss,
  perform: {
    fn: import { healthMonitorJob } from "@src/monitoring/worker"
  },
  schedule: {
    cron: "*/2 * * * *" // every 2 minutes
  },
  entities: [Instance]
}

job syncSubscriptions {
  executor: PgBoss,
  perform: {
    fn: import { syncSubscriptionsJob } from "@src/lifecycle/worker"
  },
  schedule: {
    cron: "0 * * * *" // every hour
  },
  entities: [User, Instance]
}

job suspendedCleanup {
  executor: PgBoss,
  perform: {
    fn: import { suspendedCleanupJob } from "@src/lifecycle/worker"
  },
  schedule: {
    cron: "0 4 * * *" // daily at 4am
  },
  entities: [Instance]
}

// ============================================================
// Analytics (kept from OpenSaaS template)
// ============================================================
query getDailyStats {
  fn: import { getDailyStats } from "@src/analytics/operations",
  entities: [User, DailyStats]
}

job dailyStatsJob {
  executor: PgBoss,
  perform: {
    fn: import { calculateDailyStats } from "@src/analytics/stats"
  },
  schedule: {
    cron: "0 * * * *"
  },
  entities: [User, DailyStats, Logs, PageViewSource]
}

// ============================================================
// Internal Admin Dashboard
// ============================================================
route AdminRoute { path: "/admin", to: AdminDashboardPage }
page AdminDashboardPage {
  authRequired: true,
  component: import AdminDashboardPage from "@src/admin/dashboards/analytics/AnalyticsDashboardPage"
}

route AdminUsersRoute { path: "/admin/users", to: AdminUsersPage }
page AdminUsersPage {
  authRequired: true,
  component: import AdminUsers from "@src/admin/dashboards/users/UsersDashboardPage"
}

route AdminInstancesRoute { path: "/admin/instances", to: AdminInstancesPage }
page AdminInstancesPage {
  authRequired: true,
  component: import AdminInstances from "@src/admin/dashboards/instances/InstancesDashboardPage"
}

query getAdminInstances {
  fn: import { getAdminInstances } from "@src/admin/operations",
  entities: [Instance, User]
}

route AdminInstanceDetailRoute { path: "/admin/instances/:instanceId", to: AdminInstanceDetailPage }
page AdminInstanceDetailPage {
  authRequired: true,
  component: import AdminInstanceDetail from "@src/admin/dashboards/instances/InstanceDetailPage"
}

route AdminProvisioningJobsRoute { path: "/admin/provisioning", to: AdminProvisioningJobsPage }
page AdminProvisioningJobsPage {
  authRequired: true,
  component: import AdminProvisioningJobs from "@src/admin/dashboards/instances/ProvisioningJobsPage"
}

query getAdminInstanceDetail {
  fn: import { getAdminInstanceDetail } from "@src/admin/instanceOperations",
  entities: [Instance, User, ProvisioningJob]
}

query getAdminInstanceHealth {
  fn: import { getAdminInstanceHealth } from "@src/admin/instanceOperations",
  entities: [Instance]
}

query getAdminInstanceDevices {
  fn: import { getAdminInstanceDevices } from "@src/admin/instanceOperations",
  entities: [Instance]
}

query getAdminProvisioningJobs {
  fn: import { getAdminProvisioningJobs } from "@src/admin/instanceOperations",
  entities: [ProvisioningJob, User]
}

action adminDestroyInstance {
  fn: import { adminDestroyInstance } from "@src/admin/instanceOperations",
  entities: [Instance]
}

action adminProvisionInstance {
  fn: import { adminProvisionInstance } from "@src/admin/instanceOperations",
  entities: [Instance, ProvisioningJob]
}

action adminTriggerWorker {
  fn: import { adminTriggerWorker } from "@src/admin/instanceOperations",
  entities: [Instance]
}

action adminApproveDevice {
  fn: import { adminApproveDevice } from "@src/admin/instanceOperations",
  entities: [Instance]
}

action adminRejectDevice {
  fn: import { adminRejectDevice } from "@src/admin/instanceOperations",
  entities: [Instance]
}

action adminPatchAllInstanceConfigs {
  fn: import { adminPatchAllInstanceConfigs } from "@src/admin/instanceOperations",
  entities: [Instance]
}

// ============================================================
// Waitlist / Closed Beta
// ============================================================
route WaitlistRoute { path: "/waitlist", to: WaitlistPage }
page WaitlistPage {
  authRequired: true,
  component: import WaitlistPage from "@src/payment/WaitlistPage"
}

query getAdminSettings {
  fn: import { getAdminSettings } from "@src/admin/settingsOperations",
  entities: [AdminSetting]
}

action updateAdminSetting {
  fn: import { updateAdminSetting } from "@src/admin/settingsOperations",
  entities: [AdminSetting]
}

query getClosedBetaStatus {
  fn: import { getClosedBetaStatus } from "@src/admin/settingsOperations",
  entities: [AdminSetting]
}


route TermsOfServiceRoute { path: "/tos", to: TermsOfServicePage }
page TermsOfServicePage {
  component: import TermsOfServicePage from "@src/legal/TermsOfServicePage"
}

route PrivacyPolicyRoute { path: "/pp", to: PrivacyPolicyPage }
page PrivacyPolicyPage {
  component: import PrivacyPolicyPage from "@src/legal/PrivacyPolicyPage"
}

route NotFoundRoute { path: "*", to: NotFoundPage }
page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
