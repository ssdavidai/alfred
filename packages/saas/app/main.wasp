app AlfredSaaS {
  wasp: {
    version: "^0.19.0"
  },

  title: "Alfred - Your Personal Agentic Butler",

  head: [
    "<link rel='icon' href='/favicon.ico' />",
    "<link rel='apple-touch-icon' href='/images/alfred-logo-192.png' />",
    "<meta charset='utf-8' />",
    "<meta name='description' content='Alfred is an agentic butler for people who have too many tabs open in their head. Calendar, email, finances, health data, family logistics — Alfred manages it all.' />",
    "<meta name='author' content='Alfred' />",
    "<meta name='keywords' content='alfred, agentic butler, ai assistant, personal ai, life management, automation' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='Alfred - Your Personal Agentic Butler' />",
    "<meta property='og:site_name' content='Alfred' />",
    "<meta property='og:url' content='https://alfred.black' />",
    "<meta property='og:description' content='Agentic butler for people who have too many tabs open in their head.' />",
    "<meta property='og:image' content='/images/alfred-logo-512.png' />",

    // Alfred Black theme boot — sets the `dark` class on <html> before paint,
    // avoiding a flash of incorrect theme. Source of truth for the body lives
    // in src/client/lib/theme.tsx (export `themeBootScript`); keep these two
    // copies in sync.
    "<script>(function(){try{var t=localStorage.getItem('ab-theme');if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}var r=document.documentElement;if(t==='dark')r.classList.add('dark');r.style.colorScheme=t;}catch(e){}})();</script>",

    "<link rel='preconnect' href='https://fonts.googleapis.com' />",
    "<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />",
    "<link href='https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500;700;800&display=swap' rel='stylesheet' />",

    "<script defer data-domain='alfred.black' src='https://plausible.alfred.black/js/script.js'></script>",
  ],

  auth: {
    userEntity: User,
    methods: {
      email: {
        fromField: {
          name: "Alfred",
          email: "noreply@alfred.black"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute,
          getEmailContentFn: import { getVerificationEmailContent } from "@src/auth/email-and-pass/emails",
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
          getEmailContentFn: import { getPasswordResetEmailContent } from "@src/auth/email-and-pass/emails",
        },
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
      },
      google: {
        userSignupFields: import { getGoogleUserFields } from "@src/auth/userSignupFields",
        configFn: import { getGoogleAuthConfig } from "@src/auth/userSignupFields",
      },
    },
    onAuthFailedRedirectTo: "/login",
    // Intermediate landing: if the user just signed in with Google but the
    // Wasp/Arctic OAuth flow didn't hand us a refresh_token (Arctic 1.x
    // silently drops `accessType: "offline"` + `prompt: "consent"`, so
    // Google only issues a 1h access token), PostSignupPage bounces them
    // through /auth/oauth2/google/start for a proper consent screen that
    // does return a refresh_token. Non-Google signups + already-reconnected
    // users fall through immediately to /dashboard.
    onAuthSucceededRedirectTo: "/post-signup",
    onAfterSignup: import { onAfterSignup } from "@src/auth/hooks",
    onAfterLogin: import { onAfterLogin } from "@src/auth/hooks",
  },

  db: {
    seeds: [
      import { seedMockUsers } from "@src/server/scripts/dbSeeds",
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App",
  },

  emailSender: {
    provider: Mailgun,
    defaultFrom: {
      name: "Alfred",
      email: "noreply@mg.alfred.black"
    },
  },

  server: {
    setupFn: import { serverSetup } from "@src/server/setup",
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/server/middleware",
  },
}

// ============================================================
// Landing & Marketing
// ============================================================
route LandingPageRoute { path: "/", to: LandingPage }
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}

// Public marketing — the small staff of specialists (#848). No authRequired.
route StaffRoute { path: "/staff", to: StaffPage }
page StaffPage {
  component: import StaffPage from "@src/landing-page/StaffPage"
}

// Public marketing — companion / voice / sms / voice-and-tone (#849). No authRequired.
route CompanionRoute { path: "/companion", to: CompanionPage }
page CompanionPage {
  component: import CompanionPage from "@src/landing-page/CompanionPage"
}

route VoiceRoute { path: "/voice", to: VoicePage }
page VoicePage {
  component: import VoicePage from "@src/landing-page/VoicePage"
}

route SmsRoute { path: "/sms", to: SmsPage }
page SmsPage {
  component: import SmsPage from "@src/landing-page/SmsPage"
}

route VoiceAndToneRoute { path: "/voice-and-tone", to: VoiceAndTonePage }
page VoiceAndTonePage {
  component: import VoiceAndTonePage from "@src/landing-page/VoiceAndTonePage"
}

// ============================================================
// Auth Pages
// ============================================================
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}

// Intermediate post-auth landing. See src/auth/PostSignupPage.tsx header for
// the Wasp/Arctic refresh-token bug this works around.
route PostSignupRoute { path: "/post-signup", to: PostSignupPage }
page PostSignupPage {
  authRequired: true,
  component: import PostSignupPage from "@src/auth/PostSignupPage"
}

query getGoogleRefreshTokenStatus {
  fn: import { getGoogleRefreshTokenStatus } from "@src/auth/operations",
  entities: [OAuthCredential]
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email-and-pass/RequestPasswordResetPage",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email-and-pass/PasswordResetPage",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email-and-pass/EmailVerificationPage",
}

// ============================================================
// User Account
// ============================================================
route AccountRoute { path: "/account", to: AccountPage }
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/user/operations",
  entities: [User]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/user/operations",
  entities: [User]
}

action deleteUserById {
  fn: import { deleteUserById } from "@src/user/operations",
  entities: [User, Instance, ProvisioningJob, ApiKey, ContactFormMessage]
}

action adminUpdateUser {
  fn: import { adminUpdateUser } from "@src/user/operations",
  entities: [User]
}

action adminCreateInstance {
