  authRequired: true,
  component: import StreamsPage from "@src/streams/StreamsPage"
}

route LogsRoute { path: "/dashboard/logs", to: LogsPage }
page LogsPage {
  authRequired: true,
  component: import LogsPage from "@src/dashboard/LogsPage"
}

route WorkspaceRoute { path: "/dashboard/workspace", to: WorkspacePage }
page WorkspacePage {
  authRequired: true,
  component: import WorkspacePage from "@src/dashboard/WorkspacePage"
}

route SettingsRoute { path: "/dashboard/settings", to: SettingsPage }
page SettingsPage {
  authRequired: true,
