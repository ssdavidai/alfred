# NOTE: you can let Wasp set up your Postgres DB by running `wasp start db` in a separate terminal window.
# DATABASE_URL=

# Polar payment provider
POLAR_ORGANIZATION_ACCESS_TOKEN=polar_oat_...
POLAR_WEBHOOK_SECRET=polar_whs_...
POLAR_SANDBOX_MODE=true

# Polar product IDs (Premium = $249/mo; Black is custom/contact-us, no Polar product)
PAYMENTS_PREMIUM_SUBSCRIPTION_PLAN_ID=<polar-premium-product-id>

# Admin emails (comma-separated)
ADMIN_EMAILS=me@example.com

# Hetzner Cloud API (for provisioning tenant instances)
HETZNER_API_TOKEN=<your-hetzner-api-token>

# Tailscale (for mesh networking to tenant instances)
TAILSCALE_API_KEY=<your-tailscale-api-key>
TAILSCALE_TAILNET=<your-tailnet-name>

# OpenRouter (deployed to tenant instances)
OPENROUTER_API_KEY=<optional>

# Hetzner S3 Object Storage (for tenant backups)
HETZNER_S3_ACCESS_KEY=<optional>
HETZNER_S3_SECRET_KEY=<optional>
HETZNER_S3_BUCKET=alfred-backups

# Plausible Analytics (self-hosted)
PLAUSIBLE_API_KEY=<plausible-api-key>
PLAUSIBLE_SITE_ID=app.alfred.black
PLAUSIBLE_BASE_URL=http://localhost:8000/api

# Column encryption key for API keys in PostgreSQL (32 bytes hex)
COLUMN_ENCRYPTION_KEY=<64-char-hex-string>

# AgentMail — per-tenant email inboxes (see deploy/agentmail-bootstrap.md)
# Leave AGENTMAIL_ENABLED=false to skip AgentMail provisioning entirely.
AGENTMAIL_ENABLED=false
AGENTMAIL_MASTER_API_KEY=<am_us_... from agentmail console>
AGENTMAIL_DOMAIN=mail.alfred.black
AGENTMAIL_SHARED_POD_ID=<pod_id from bootstrap>
AGENTMAIL_WEBHOOK_ID=<webhook_id from bootstrap>
AGENTMAIL_WEBHOOK_SECRET=<whsec_... from bootstrap>

# Path to alfred-ctrl CLI (default: /opt/alfred-saas/alfred-ctrl/dist/index.mjs)
# ALFRED_CTRL_PATH=/opt/alfred-saas/alfred-ctrl/dist/index.mjs
# ALFRED_CTRL_CWD=/opt/alfred-saas/alfred-ctrl

# Email provider (use Dummy for development, SendGrid for production)
# SENDGRID_API_KEY=<your-sendgrid-api-key>

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=<your-google-client-id>
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>

# AgentPhone (Twilio + OpenAI Realtime) — master account at SaaS edge
TWILIO_ACCOUNT_SID=AC<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# Used to sign /voice/<tenantId> WS upgrade query and as Bearer for tenant↔SaaS internal calls
VOICE_BRIDGE_INTERNAL_TOKEN=<random-32-byte-hex>
# Bridge service port on the SaaS host (Caddy proxies wss://alfred.black/voice/* to here)
VOICE_BRIDGE_PORT=9000
# OpenAI key used by the Voice Bridge for the Realtime API
OPENAI_API_KEY=sk-<your-openai-api-key>
# Default country for newly provisioned Twilio numbers when tenant locale is unknown
TWILIO_DEFAULT_COUNTRY=HU
# Daily spend caps (per tenant)
TWILIO_DAILY_SMS_LIMIT=500
TWILIO_DAILY_CALL_LIMIT=100

# Operator CLI auth — long-lived bearer for admin endpoints (e.g.
# /api/admin/ssh-key) that a shell-side operator can use without holding a
# Wasp session. Set to a random 32+ byte hex string; store the same value in
# GitHub Actions secret OPERATOR_ADMIN_TOKEN and in the operator's local
# packages/ctrl/.env. Leave empty to disable the operator auth path (only
# browser-session admin auth will work then).
OPERATOR_ADMIN_TOKEN=<random-32-byte-hex>
