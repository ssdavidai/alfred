#!/usr/bin/env python3
"""
openclaw-wrapper — runs OpenClaw agents via the gateway sessions_spawn HTTP API.

Replaces the previous bash script that ran a local OpenClaw CLI inside the
alfred container.  Now calls the gateway directly over HTTP, which gives
agents full tool access (read, write, exec) and avoids the ws:// security
check, version mismatch warnings, and TCP proxy hacks.

Alfred calls:  openclaw-wrapper [--agent <id>] [--workspace <path>] <prompt>
We call:        POST http://openclaw:18789/tools/invoke  (sessions_spawn)
Then poll:      POST http://openclaw:18789/tools/invoke  (sessions_history)
"""

import json
import os
import sys
import time
import urllib.request
import urllib.error


def resolve_gateway():
    """Resolve gateway URL and auth token from environment."""
    url = os.environ.get("OPENCLAW_GATEWAY_URL", "http://openclaw:18789")
    # Normalize ws:// to http:// for HTTP API calls
    url = url.replace("ws://", "http://").replace("wss://", "https://")

    # Always read the token directly from the file on disk.
    # Do NOT trust the env var — the entrypoint's export may not propagate
    # correctly through the daemon's subprocess chain, and docker-compose
    # env_file values can interfere.
    token = ""
    for path in ["/app/data/.gateway-token", "/alfred-data/.gateway-token"]:
        if os.path.exists(path):
            token = open(path).read().strip()
            if token:
                break
    if not token:
        # Last resort: try env vars
        token = os.environ.get("OPENCLAW_GATEWAY_TOKEN", "")
        if not token:
            token_file = os.environ.get("OPENCLAW_GATEWAY_TOKEN_FILE", "")
            if token_file and os.path.exists(token_file):
                token = open(token_file).read().strip()

    return url, token


def invoke_tool(gateway_url, token, tool, args, timeout=30):
    """Call POST /tools/invoke on the OpenClaw gateway."""
    payload = json.dumps({"tool": tool, "args": args}).encode()
    req = urllib.request.Request(
        f"{gateway_url}/tools/invoke",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def extract_session_key(spawn_data):
    """Extract childSessionKey from sessions_spawn response."""
    result = spawn_data.get("result", {})
    content_list = result.get("content", [])
    for item in content_list:
        if isinstance(item, dict) and item.get("type") == "text":
            try:
                inner = json.loads(item["text"])
                key = inner.get("childSessionKey")
                if key:
                    return key
            except (json.JSONDecodeError, KeyError):
                pass
    return None


def extract_last_assistant_message(hist_data):
    """Extract the last assistant message text from sessions_history response."""
    result = hist_data.get("result", {})
    content_list = result.get("content", [])
    messages = []
    for item in content_list:
        if isinstance(item, dict) and item.get("type") == "text":
            try:
                parsed = json.loads(item["text"])
                messages = parsed.get("messages", [])
            except (json.JSONDecodeError, TypeError):
                pass

    # Walk messages in reverse to find the last assistant message
    for msg in reversed(messages):
        if msg.get("role") == "assistant":
            content = msg.get("content", "")
            if isinstance(content, list):
                for part in content:
                    if isinstance(part, dict) and part.get("type") == "text":
                        return part["text"]
            elif isinstance(content, str):
                return content
    return None


def main():
    agent_id = ""
    workspace = ""
    session_id = ""
    prompt = ""

    # The alfred Python code calls:
    #   openclaw-wrapper agent --agent <id> --session-id <sid> --message "<prompt>" --local --json
    # We need to parse all these flags properly.
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--agent":
            agent_id = args[i + 1]
            i += 2
        elif args[i] == "--workspace":
            workspace = args[i + 1]
            i += 2
        elif args[i] == "--message":
            prompt = args[i + 1]
            i += 2
        elif args[i] == "--session-id":
            session_id = args[i + 1]
            i += 2
        elif args[i] in ("--local", "--json", "agent"):
            # Flags we accept but don't use (handled by gateway)
            i += 1
        else:
            # Fallback: treat as prompt if --message wasn't used
            if not prompt:
                prompt = args[i]
            i += 1

    if not prompt:
        print("Error: no prompt provided", file=sys.stderr)
        sys.exit(1)

    # The curator pipeline writes the prompt to a temp file and passes
    # "--message 'Follow the instructions in /tmp/...'". Since sessions_spawn
    # runs in the openclaw container (different filesystem), we need to read
    # the file and pass the content directly.
    if prompt.startswith("Follow the instructions in "):
        file_path = prompt.split("Follow the instructions in ", 1)[1].strip()
        try:
            prompt = open(file_path).read()
        except FileNotFoundError:
            print(f"Error: prompt file not found: {file_path}", file=sys.stderr)
            sys.exit(1)

    gateway_url, token = resolve_gateway()

    # Debug: log what we resolved (visible in alfred container logs)
    token_preview = f"{token[:8]}...{token[-4:]}" if len(token) > 12 else "(empty)"
    print(f"[openclaw-wrapper] gateway={gateway_url} token={token_preview} agent={agent_id} prompt_len={len(prompt)}", file=sys.stderr)

    if not token:
        print("Error: no gateway token found", file=sys.stderr)
        sys.exit(1)

    # Step 1: Spawn the agent session (with retry for gateway startup)
    spawn_data = None
    last_error = None
    for attempt in range(6):  # 6 attempts, ~30s total
        try:
            spawn_data = invoke_tool(
                gateway_url,
                token,
                "sessions_spawn",
                {
                    "task": prompt,
                    "agentId": agent_id or "main",
                    "mode": "run",
                    "cleanup": "keep",
                    "sandbox": "inherit",
                    "runTimeoutSeconds": 480,
                },
                timeout=30,
            )
            break  # success
        except urllib.error.HTTPError as e:
            body = e.read().decode() if e.fp else ""
            # Retry on 401/503 — gateway may still be initializing auth
            if e.code in (401, 503) and attempt < 5:
                print(f"[openclaw-wrapper] retry {attempt+1}/5: HTTP {e.code}", file=sys.stderr)
                time.sleep(5)
                continue
            print(f"sessions_spawn failed ({e.code}): {body}", file=sys.stderr)
            sys.exit(1)
        except Exception as e:
            last_error = e
            if attempt < 5:
                print(f"[openclaw-wrapper] retry {attempt+1}/5: {e}", file=sys.stderr)
                time.sleep(5)
            else:
                print(f"sessions_spawn error after 6 attempts: {e}", file=sys.stderr)
                sys.exit(1)

    if spawn_data is None:
        print(f"sessions_spawn failed: {last_error}", file=sys.stderr)
        sys.exit(1)

    session_key = extract_session_key(spawn_data)
    if not session_key:
        print(f"No session key in response: {json.dumps(spawn_data)}", file=sys.stderr)
        sys.exit(1)

    # Step 2: Poll sessions_history for the result
    max_attempts = 60  # 60 * 10s = 600s max (matches wrapper timeout)
    for attempt in range(max_attempts):
        time.sleep(10)
        try:
            hist_data = invoke_tool(
                gateway_url,
                token,
                "sessions_history",
                {"sessionKey": session_key, "limit": 10},
                timeout=15,
            )
        except Exception:
            continue

        text = extract_last_assistant_message(hist_data)
        if text:
            # Return the agent's response on stdout
            print(text)
            sys.exit(0)

    print("Timed out waiting for agent response", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
