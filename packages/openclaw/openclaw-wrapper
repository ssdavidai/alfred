#!/usr/bin/env bash
# openclaw-wrapper — bridges Alfred's backend CLI calls to OpenClaw agent execution.
#
# Alfred calls:  openclaw-wrapper [--agent <id>] [--workspace <path>] <prompt>
# OpenClaw:      openclaw agent --message "<prompt>" --agent <id> --workspace <path> --json

set -euo pipefail

AGENT_ID=""
WORKSPACE=""
PROMPT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --agent)
            AGENT_ID="$2"
            shift 2
            ;;
        --workspace)
            WORKSPACE="$2"
            shift 2
            ;;
        *)
            PROMPT="$1"
            shift
            ;;
    esac
done

ARGS=(agent --message "$PROMPT")
[[ -n "$AGENT_ID" ]] && ARGS+=(--agent "$AGENT_ID")
[[ -n "$WORKSPACE" ]] && ARGS+=(--workspace "$WORKSPACE")
ARGS+=(--json)

# Do NOT suppress stderr — we need to see errors for debugging
exec openclaw "${ARGS[@]}"
