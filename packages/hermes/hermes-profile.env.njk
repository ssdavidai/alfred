{#
  hermes-profile.env.njk — per-profile .env, rendered once per Hermes
  profile by the init container alongside hermes-config.yaml.

  Rendered to:
    ~/.hermes/profiles/main/.env      (profile = "main",    port 18789)
    ~/.hermes/profiles/workers/.env   (profile = "workers", port 18790)

  Hermes reads API_SERVER_* and provider keys from .env, NOT config.yaml.

  PORT LAYOUT — the shim, not Hermes, owns the legacy port:
    profile  legacy port (shim binds)   Hermes API server (this .env)
    main     18789                      18799
    workers  18790                      18800
  Legacy callers hit :18789/:18790 (the shim); the shim forwards to
  Hermes on :18799/:18800. Both bind 127.0.0.1 — only the shim and the
  Hermes API server talk to each other, in-process to the container.

  Template variables:
    profile             "main" | "workers"             (required)
    api_server_port     18799 (main) | 18800 (workers)  (required)
    api_server_key      the gateway token — the value of
                        /alfred-data/.gateway-token     (required)
    api_server_host     bind address (default 127.0.0.1 — the shim is the
                        only caller, and it runs in the same container)
    api_server_cors     comma-separated CORS allowlist  (optional)
    openrouter_api_key  OPENROUTER_API_KEY              (required)
    anthropic_api_key   ANTHROPIC_API_KEY               (optional)
    openai_api_key      OPENAI_API_KEY                  (optional)
    composio_api_key    COMPOSIO_API_KEY                (optional)
    composio_user_id    COMPOSIO_USER_ID                (optional)
#}
{%- set api_server_host = api_server_host | default("127.0.0.1") -%}
# Hermes Agent .env — profile: {{ profile }}
# Generated by the alfred-black init container. Re-run init to regenerate.

# -----------------------------------------------------------------------------
# OpenAI-compatible API server
# -----------------------------------------------------------------------------
# Enabled so the hermes-shim (and, post-Phase-1, native callers) can reach
# this profile over /v1/runs + /v1/responses. The hermes-shim binds the
# legacy OpenClaw port (18789/18790) and translates; Hermes itself listens
# on the internal port below (18799/18800), localhost-only.
API_SERVER_ENABLED=true
API_SERVER_PORT={{ api_server_port }}
API_SERVER_HOST={{ api_server_host }}
# Bearer token. This is the value of /alfred-data/.gateway-token — the same
# token legacy callers already use, so no caller's token logic changes.
API_SERVER_KEY={{ api_server_key }}
{%- if api_server_cors %}
API_SERVER_CORS_ORIGINS={{ api_server_cors }}
{%- endif %}
# Advertise this profile's name on /v1/models.
API_SERVER_MODEL_NAME={{ profile }}

# -----------------------------------------------------------------------------
# LLM provider keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY={{ openrouter_api_key | default("") }}
{%- if anthropic_api_key %}
ANTHROPIC_API_KEY={{ anthropic_api_key }}
{%- endif %}
{%- if openai_api_key %}
OPENAI_API_KEY={{ openai_api_key }}
{%- endif %}

# -----------------------------------------------------------------------------
# ctrl-api / Composio — consumed by the MCP stdio children
# -----------------------------------------------------------------------------
AAS_API_KEY={{ aas_api_key | default("") }}
{%- if composio_api_key %}
COMPOSIO_API_KEY={{ composio_api_key }}
{%- endif %}
{%- if composio_user_id %}
COMPOSIO_USER_ID={{ composio_user_id }}
{%- endif %}

# -----------------------------------------------------------------------------
# Gateway behaviour
# -----------------------------------------------------------------------------
{%- if profile == "workers" %}
# Workers run no messaging channels — nothing to allowlist. The gateway
# only services API-server / runs traffic from the shim.
GATEWAY_ALLOW_ALL_USERS=false
{%- endif %}
HERMES_HUMAN_DELAY_MODE=off
