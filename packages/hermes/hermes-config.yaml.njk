{#
  hermes-config.yaml.njk — one Nunjucks template, rendered once per Hermes
  profile. Replaces both openclaw-config.json.njk and
  openclaw-workers-config.json.njk.

  Rendered by the init container (packages/hermes/init/entrypoint.sh) to:
    ~/.hermes/profiles/main/config.yaml      (profile = "main")
    ~/.hermes/profiles/workers/config.yaml   (profile = "workers")

  Template variables:
    profile          "main" | "workers"          (required)
    vault_path       absolute path to the vault   (default /vault)
    ctrl_api_url     ctrl-api base URL            (default http://ctrl-api:3100)
    mcp_stdio_dir    dir holding the 5-app stdio bundle
                                                  (default ~/.hermes/profiles/<p>/mcp-stdio)
    mcp_ctrl_script  path to ctrl-server.mjs
                                                  (default ~/.hermes/profiles/<p>/mcp/ctrl-server.mjs)
    node_modules     NODE_PATH for the ctrl MCP server
                                                  (default /opt/mcp-stdio/node_modules)
    alfred_prime     "true" on Alfred Prime, else unset/empty
    cross_tenant_peers   JSON array string, Prime only

  NOTE: API server settings (API_SERVER_*) are NOT config.yaml keys in
  Hermes — they are environment variables. They are rendered into the
  per-profile .env by hermes-profile.env.njk, not here.

  Two profiles, one image, two `hermes -p <profile> gateway` processes:
    main    — user-facing chat. Memory + channels enabled. API on :18789.
    workers — background agents only. Memory minimal, concurrency capped
              at 1, no channels. API on :18790.
#}
{%- set is_main = (profile == "main") -%}
{%- set vault_path = vault_path | default("/vault") -%}
{%- set ctrl_api_url = ctrl_api_url | default("http://ctrl-api:3100") -%}
{%- set mcp_stdio_dir = mcp_stdio_dir | default("/opt/data/profiles/" + profile + "/mcp-stdio") -%}
{%- set mcp_ctrl_script = mcp_ctrl_script | default("/opt/data/profiles/" + profile + "/mcp/ctrl-server.mjs") -%}
{%- set node_modules = node_modules | default(mcp_stdio_dir + "/node_modules") -%}
# Hermes Agent configuration — profile: {{ profile }}
# Generated by the alfred-black init container. Do not hand-edit; re-run init
# to regenerate. User-facing knobs live in the per-profile .env.

# =============================================================================
# Model
# =============================================================================
model:
{%- if is_main %}
  # User-facing Alfred — a capable model for the live chat surface.
  # Bare OpenRouter model ID; provider/base_url below do the routing.
  default: "{{ main_model }}"
{%- else %}
  # Background workers — a cheaper model; these agents are autonomous and
  # high-volume (clerk classification, vault curation, ephemeral executors).
  default: "{{ workers_model }}"
{%- endif %}
  provider: "openrouter"
  base_url: "https://openrouter.ai/api/v1"

# =============================================================================
# Agent behaviour
# =============================================================================
agent:
  # Tool-calling iteration ceiling per conversation.
{%- if is_main %}
  max_turns: 80
{%- else %}
  max_turns: 50
{%- endif %}
  reasoning_effort: "medium"
  verbose: false
  # Graceful drain on gateway stop/restart — let in-flight agents finish.
  restart_drain_timeout: 60

# =============================================================================
# Context compression — auto-shrink long conversations
# =============================================================================
compression:
  enabled: true
  threshold: 0.60
  target_ratio: 0.20
  protect_last_n: 20
  protect_first_n: 3

# =============================================================================
# Persistent memory
# =============================================================================
memory:
{%- if is_main %}
  # The user-facing Alfred keeps a curated memory + user profile so it
  # remembers the principal across sessions.
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  nudge_interval: 10
  flush_min_turns: 6
{%- else %}
  # Workers are stateless classification/curation agents — no conversation
  # memory. This is the Hermes equivalent of OpenClaw's
  # `plugins.slots.memory = "none"` on the workers gateway: it stops the
  # unbounded memory-store growth that caused the QMD compaction death loop.
  memory_enabled: false
  user_profile_enabled: false
  nudge_interval: 0
  flush_min_turns: 0
{%- endif %}

# =============================================================================
# Session reset policy
# =============================================================================
session_reset:
{%- if is_main %}
  # Reset the live chat on inactivity OR a daily boundary so context (and
  # token spend) does not grow without bound.
  mode: both
  idle_minutes: 1440
  at_hour: 4
{%- else %}
  # Workers run one-shot tasks; reset aggressively on idle so a worker
  # session never lingers and accumulates transcript.
  mode: idle
  idle_minutes: 30
{%- endif %}
group_sessions_per_user: true

# =============================================================================
# Subagent delegation
# =============================================================================
delegation:
{%- if is_main %}
  max_iterations: 50
  max_concurrent_children: 3
  max_spawn_depth: 1
{%- else %}
  # Concurrency cap = 1. Background workers serialise all LLM calls — this
  # is the Hermes equivalent of OpenClaw's `agents.defaults.maxConcurrent: 1`
  # on the workers gateway. Prevents a burst of parallel calls blowing
  # through the provider's TPM limit.
  max_iterations: 50
  max_concurrent_children: 1
  max_spawn_depth: 1
  # Cron/batch pipelines own no stdin — auto-resolve approval prompts so a
  # background run never deadlocks waiting for a TTY.
  subagent_auto_approve: false
{%- endif %}

# =============================================================================
# Command approval
# =============================================================================
# Hermes-native per-command safety gate (Codex-inspired). Replaces the
# bespoke ctrl-api approval path that used to wrap a non-existent `hermes
# devices` CLI surface.
approvals:
{%- if is_main %}
  # The user-facing Alfred runs against a live principal who can answer a
  # prompt. `smart` uses an auxiliary LLM to risk-assess each command:
  # low-risk commands auto-approve, genuinely dangerous ones auto-deny, and
  # only ambiguous cases escalate to the principal.
  mode: smart
  timeout: 60
{%- else %}
  # Background workers run autonomously on cron/batch pipelines with no TTY
  # and no human to answer a prompt — a `manual`/`smart` escalation would
  # deadlock the run. `tool_loop_guardrails` (below) is the safety net that
  # actually fits an unattended worker: a hard stop on stuck loops.
  mode: off
{%- endif %}

# =============================================================================
# Tool loop guardrails
# =============================================================================
tool_loop_guardrails:
  warnings_enabled: true
{%- if is_main %}
  hard_stop_enabled: false
{%- else %}
  # Background runs have no human watching — a hard stop is preferable to
  # burning the full iteration budget in a stuck loop.
  hard_stop_enabled: true
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5
{%- endif %}

# =============================================================================
# Terminal tool
# =============================================================================
terminal:
  # Local backend — the gateway process runs as the `hermes` user inside the
  # container. The Docker terminal backend can be layered later to sandbox
  # each ephemeral run; orthogonal to the profile split.
  backend: "local"
  cwd: "/opt/data/profiles/{{ profile }}/workspace"
  timeout: 180
  lifetime_seconds: 300

# =============================================================================
# Skills
# =============================================================================
skills:
  creation_nudge_interval: 0
  # Platform-native Alfred skills are deployed by the init container into
  # the profile's skills/ directory. The vault-worker skills
  # (vault-curator / vault-janitor / vault-distiller) are also synced there.

# =============================================================================
# Code execution sandbox
# =============================================================================
code_execution:
  timeout: 300
  max_tool_calls: 50

# =============================================================================
# Platform toolsets — which tools each surface may use
# =============================================================================
# This is the Hermes equivalent of OpenClaw's `gateway.tools.allow` array.
# The migrated allowlist: the OpenClaw allowlist was {message, sessions_*,
# ctrl_vault_*, ctrl_stream_ingest}. In Hermes the `sessions_*` primitives
# are subsumed by the `delegate_task` subagent tool and the run lifecycle;
# the `ctrl_*` surface is provided by the MCP servers below (auto-namespaced
# as mcp_alfred_ctrl_*). So the toolset list is the built-in capability set
# the profile is allowed to compose from. MCP tools are always available
# once their server is registered — toolsets gate only built-in tools.
platform_toolsets:
{%- if is_main %}
  # The user-facing Alfred: full built-in surface incl. messaging.
  cli: [hermes-cli]
  telegram: [hermes-telegram]
  slack: [hermes-slack]
  discord: [hermes-discord]
  whatsapp: [hermes-whatsapp]
  signal: [hermes-signal]
{%- else %}
  # Workers: terminal + file + web + skills + todo + delegation. No
  # messaging toolset — workers never deliver to a channel directly
  # (notify_principal bridges through ctrl-api → the main profile).
  cli: [terminal, file, web, vision, skills, todo]
{%- endif %}

# =============================================================================
# MCP (Model Context Protocol) servers
# =============================================================================
# Six servers, identical on both profiles — migrated verbatim from the
# OpenClaw `mcp.servers` block. One HTTP proxy + five stdio apps. Hermes
# auto-namespaces every tool as mcp_<server>_<tool>.
mcp_servers:

  # --- alfred-ctrl: HTTP proxy into this VM's ctrl-api ---------------------
  # A stdio MCP server (ctrl-server.mjs) that exposes the `self` tool — a
  # generic HTTP proxy to ctrl-api. On Alfred Prime it additionally exposes
  # the `tenant` and `ask_alfred` cross-tenant tools.
  alfred-ctrl:
    command: "node"
    args: ["{{ mcp_ctrl_script }}"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
      NODE_PATH: "{{ node_modules }}"
{%- if alfred_prime == "true" %}
      ALFRED_PRIME: "true"
{%- if cross_tenant_peers %}
      CROSS_TENANT_PEERS: '{{ cross_tenant_peers | safe }}'
{%- endif %}
{%- endif %}
    timeout: 120
    connect_timeout: 60

  # --- The 5-app stdio bundle ----------------------------------------------
  # Same tool catalogue the HTTP alfred-mcp-server exposes to claude.ai
  # Custom Connectors, served over stdio so the gateway can spawn each app
  # as a child process. Source: packages/mcp-server/src/bin/stdio-app.ts.
  alfred:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "alfred"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  sure:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "sure"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  plane:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "plane"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  vaultwarden:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "vaultwarden"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  execute:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "execute"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

# =============================================================================
# Display
# =============================================================================
display:
  compact: false
  tool_progress: {% if is_main %}all{% else %}new{% endif %}

  interim_assistant_messages: {% if is_main %}true{% else %}false{% endif %}

  streaming: true
