{#
  hermes-config.yaml.njk — one Nunjucks template, rendered once per Hermes
  profile. Replaces both openclaw-config.json.njk and
  openclaw-workers-config.json.njk.

  Rendered by the init container (packages/hermes/init/entrypoint.sh) to:
    ~/.hermes/profiles/main/config.yaml      (profile = "main")
    ~/.hermes/profiles/workers/config.yaml   (profile = "workers")
    ~/.hermes/profiles/heavy/config.yaml     (profile = "heavy")

  Template variables:
    profile          "main" | "workers" | "heavy"  (required)
    vault_path       absolute path to the vault   (default /vault)
    ctrl_api_url     ctrl-api base URL            (default http://ctrl-api:3100)
    mcp_stdio_dir    dir holding the 5-app stdio bundle
                                                  (default ~/.hermes/profiles/<p>/mcp-stdio)
    mcp_ctrl_script  path to ctrl-server.mjs
                                                  (default ~/.hermes/profiles/<p>/mcp/ctrl-server.mjs)
    node_modules     NODE_PATH for the ctrl MCP server
                                                  (default /opt/mcp-stdio/node_modules)
    alfred_prime     "true" on Alfred Prime, else unset/empty
    cross_tenant_peers   JSON array string, Prime only

  NOTE: API server settings (API_SERVER_*) are NOT config.yaml keys in
  Hermes — they are environment variables. They are rendered into the
  per-profile .env by hermes-profile.env.njk, not here.

  Three profiles, one image, three `hermes -p <profile> gateway` processes:
    main    — user-facing chat. Memory + channels enabled. API on :18789.
    workers — background agents only. Memory minimal, concurrency capped
              at 1, no channels. API on :18790.
    heavy   — background heavy-reasoning (onboarding + chore heavy steps).
              Same minimal-memory / no-channels / capped-concurrency posture
              as workers, but on an Opus-class model. API on :18791.
#}
{%- set is_main = (profile == "main") -%}
{%- set vault_path = vault_path | default("/vault") -%}
{%- set ctrl_api_url = ctrl_api_url | default("http://ctrl-api:3100") -%}
{%- set mcp_stdio_dir = mcp_stdio_dir | default("/opt/data/profiles/" + profile + "/mcp-stdio") -%}
{%- set mcp_ctrl_script = mcp_ctrl_script | default("/opt/data/profiles/" + profile + "/mcp/ctrl-server.mjs") -%}
{%- set node_modules = node_modules | default(mcp_stdio_dir + "/node_modules") -%}
{%- set runtime_profile_dir = runtime_profile_dir | default("/opt/data/profiles/" + profile) -%}
# Hermes Agent configuration — profile: {{ profile }}
# Generated by the alfred-black init container. Do not hand-edit; re-run init
# to regenerate. User-facing knobs live in the per-profile .env.

# =============================================================================
# Model
# =============================================================================
{%- if profile == "codex-builder" %}
# codex-builder is the sealed-runtime builder profile (docs/codex-builder-
# runtime.md §2). Provider is HARD-PINNED to openai-codex — the codex CLI
# this profile shells out to authenticates via ChatGPT OAuth, and the
# supervising agent's LLM turns should use the same provider so the system
# stays internally consistent. NOT overridable from .env: a future tenant
# .env edit cannot accidentally swing this profile back to openrouter.
model:
  default: "{{ codex_builder_model | default('gpt-5-codex') }}"
  provider: "openai-codex"
  # No base_url for openai-codex — Hermes resolves the endpoint internally
  # from the ChatGPT auth.json (shared with main per Sir's decision #1).
  max_tokens: 8192
{%- else %}
model:
{%- if is_main %}
  # User-facing Alfred — a capable model for the live chat surface.
  # Bare OpenRouter model ID; provider/base_url below do the routing.
  default: "{{ main_model }}"
{%- elif profile == "heavy" %}
  # Heavy background reasoning (onboarding + chore heavy steps) — an
  # Opus-class model. Background posture (no channels, minimal memory,
  # capped concurrency) like workers, but a much stronger model.
  default: "{{ heavy_model }}"
{%- else %}
  # Background workers — a cheaper model; these agents are autonomous and
  # high-volume (clerk classification, vault curation, ephemeral executors).
  default: "{{ workers_model }}"
{%- endif %}
  provider: "openrouter"
  base_url: "https://openrouter.ai/api/v1"
  # Per-request output-token ceiling.
  #
  # OpenRouter's affordability gate reserves `max_tokens × upstream-output
  # cost` before billing. With the default (unset → model max ≈ 65 536) on
  # gpt-5.5, the reservation exceeds the typical $50–100 credit floor and
  # OpenRouter returns 402 ("can only afford N tokens of 65 536 requested")
  # before the request ever runs. 8 192 is well above any chore or chat
  # turn's real need, and small enough to stay under the reserve gate.
  #
  # When a profile is later flipped to `provider: openai-codex` this value
  # is harmless — run_agent translates it via `_max_tokens_param()` into
  # `max_completion_tokens` for direct-OpenAI / Codex endpoints.
  #
  # Sir 2026-05-27 — see joe.alfred.black cdsk incident: tool routing died
  # on this exact gate while the OpenRouter key still had $46 of credit.
  max_tokens: 8192
{%- endif %}

# =============================================================================
# Agent behaviour
# =============================================================================
agent:
  # Tool-calling iteration ceiling per conversation.
{%- if is_main %}
  max_turns: 80
{%- elif profile == "codex-builder" %}
  # codex-builder spends most of its turns shelling out to `codex exec`;
  # 50 is consistent with workers/heavy and matches Sir's hand-off spec.
  max_turns: 50
  # Reason hard, act cheap — most "thought" happens inside the codex CLI.
  reasoning_effort: "high"
{%- else %}
  max_turns: 50
{%- endif %}
{%- if profile != "codex-builder" %}
  reasoning_effort: "medium"
{%- endif %}
  verbose: false
  # Graceful drain on gateway stop/restart — let in-flight agents finish.
  restart_drain_timeout: 60

# =============================================================================
# Cron jobs
# =============================================================================
{%- if is_main %}
cron:
  # Deliver cron-job output as a clean message — no header/footer.
  #
  # Hermes' cron scheduler defaults to wrapping every delivered cron result
  # with a "Cronjob Response: <job-name>\n(job_id: …)" header and a
  # "To stop or manage this job…" footer (cron/scheduler.py::_deliver_result,
  # v2026.5.16 — `wrap_response` defaults True). The main profile's only cron
  # consumers are notify_principal (ctrl-api's POST /api/v1/notifications
  # creates a one-shot delivery job) and any user-set reminders — for both the
  # principal should see the message itself, not scheduler chrome. Setting
  # wrap_response: false makes _deliver_result use the raw content verbatim.
  #
  # This is read per-profile: load_config() resolves config.yaml under each
  # gateway process's own HERMES_HOME, so this affects main-profile cron jobs
  # only. The workers profile renders no `cron:` block and is unaffected.
  wrap_response: false
{%- elif profile == "codex-builder" %}
# codex-builder cron job — daily GC of /work/runs older than 7 days. Sir's
# spec calls for ephemeral workspaces; the run dir is left in place after
# a run for operator forensics (see docs/codex-builder-runtime.md §5) and
# GC'd on this schedule. wrap_response: false because the only consumer is
# `cleanup-old-runs` and the gateway's response wrap would just be noise.
cron:
  wrap_response: false
  jobs:
    - name: cleanup-old-runs
      schedule: "13 3 * * *"
      command: "find /work/runs -maxdepth 1 -mindepth 1 -type d -mtime +7 -exec rm -rf {} +"
{%- else %}
# Workers profile: no cron consumers — cron is left at Hermes defaults.
{%- endif %}

# =============================================================================
# Context compression — auto-shrink long conversations
# =============================================================================
compression:
  enabled: true
  threshold: 0.60
  target_ratio: 0.20
  protect_last_n: 20
  protect_first_n: 3

# =============================================================================
# Persistent memory
# =============================================================================
memory:
{%- if is_main %}
  # The user-facing Alfred keeps a curated memory + user profile so it
  # remembers the principal across sessions.
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  nudge_interval: 10
  flush_min_turns: 6
{%- else %}
  # Workers/heavy/codex-builder are stateless classification/curation/build
  # agents — no conversation memory. This is the Hermes equivalent of
  # OpenClaw's `plugins.slots.memory = "none"` on the workers gateway: it
  # stops the unbounded memory-store growth that caused the QMD compaction
  # death loop. codex-builder additionally is one-shot per run — there is
  # no "user" or "principal" identity here, so user_profile would be empty.
  memory_enabled: false
  user_profile_enabled: false
  nudge_interval: 0
  flush_min_turns: 0
{%- endif %}

# =============================================================================
# Session reset policy
# =============================================================================
session_reset:
{%- if is_main %}
  # Reset the live chat on inactivity OR a daily boundary so context (and
  # token spend) does not grow without bound.
  mode: both
  idle_minutes: 1440
  at_hour: 4
{%- elif profile == "codex-builder" %}
  # Builder runs are one-shot per Paperclip issue — reset aggressively
  # so the next run starts with no carry-over context. 5 min is well
  # under the 30-min terminal.timeout below; a successful run finishes
  # and the session goes idle, the next heartbeat finds it reset.
  mode: idle
  idle_minutes: 5
{%- else %}
  # Workers run one-shot tasks; reset aggressively on idle so a worker
  # session never lingers and accumulates transcript.
  mode: idle
  idle_minutes: 30
{%- endif %}
group_sessions_per_user: true

# =============================================================================
# Subagent delegation
# =============================================================================
delegation:
{%- if is_main %}
  max_iterations: 50
  max_concurrent_children: 3
  max_spawn_depth: 1
{%- elif profile == "codex-builder" %}
  # codex-builder NEVER delegates. The whole point is one sealed
  # supervisor per Paperclip issue, driving codex-CLI through a
  # restricted terminal. A spawned sub-agent would inherit none of the
  # workspace mount logic and could undermine the security boundary by
  # routing back through main's MCP catalogue (the orchestrator
  # pattern in §1 is "Paperclip splits the work, not Hermes").
  max_iterations: 50
  max_concurrent_children: 1
  max_spawn_depth: 0
  subagent_auto_approve: false
{%- else %}
  # Concurrency cap = 1. Background workers serialise all LLM calls — this
  # is the Hermes equivalent of OpenClaw's `agents.defaults.maxConcurrent: 1`
  # on the workers gateway. Prevents a burst of parallel calls blowing
  # through the provider's TPM limit.
  max_iterations: 50
  max_concurrent_children: 1
  max_spawn_depth: 1
  # Cron/batch pipelines own no stdin — auto-resolve approval prompts so a
  # background run never deadlocks waiting for a TTY.
  subagent_auto_approve: false
{%- endif %}

# =============================================================================
# Command approval
# =============================================================================
# Hermes-native per-command safety gate (Codex-inspired). Replaces the
# bespoke ctrl-api approval path that used to wrap a non-existent `hermes
# devices` CLI surface.
approvals:
{%- if is_main %}
  # The user-facing Alfred runs against a live principal who can answer a
  # prompt. `smart` uses an auxiliary LLM to risk-assess each command:
  # low-risk commands auto-approve, genuinely dangerous ones auto-deny, and
  # only ambiguous cases escalate to the principal.
  mode: smart
  timeout: 60
{%- else %}
  # Background workers / heavy / codex-builder run autonomously on cron /
  # batch pipelines with no TTY and no human to answer a prompt — a
  # `manual`/`smart` escalation would deadlock the run. For codex-builder
  # specifically: the codex CLI's own `--sandbox workspace-write` is the
  # safety net, not Hermes' approval surface. `tool_loop_guardrails`
  # (below) is the additional belt-and-braces stop on stuck loops.
  mode: off
{%- endif %}

# =============================================================================
# Tool loop guardrails
# =============================================================================
tool_loop_guardrails:
  warnings_enabled: true
{%- if is_main %}
  hard_stop_enabled: false
{%- else %}
  # Background runs have no human watching — a hard stop is preferable to
  # burning the full iteration budget in a stuck loop.
  hard_stop_enabled: true
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5
{%- endif %}

# =============================================================================
# Terminal tool
# =============================================================================
terminal:
  # Local backend — the gateway process runs as the `hermes` user inside the
  # container. The Docker terminal backend can be layered later to sandbox
  # each ephemeral run; orthogonal to the profile split.
  backend: "local"
  # The profile dir, in the RUNTIME container's view (HERMES_HOME). Was
  # hardcoded /opt/data/...; that is a dead path on boxes whose HERMES_HOME
  # diverges (e.g. /hermes-state), so it now derives from the runtime profile
  # dir render_hermes bakes in. Pointed at the profile dir root (not the
  # workspace/ subdir) so it co-locates with the AGENTS.md the gateway loads.
{%- if profile == "codex-builder" %}
  # codex-builder runs codex out of /work (a separately-mounted named volume
  # owned by uid 10001). workspace/ is a symlink into /work/runs created by
  # the per-run prep script (PR 4); this cwd is the entry point.
  cwd: "{{ runtime_profile_dir }}/workspace"
  # 30-min wall-clock budget per `codex exec` (Sir's decision #3). Matches
  # the Paperclip-side runTimeoutMs (see docs/codex-builder-runtime.md §7).
  timeout: 1800
  lifetime_seconds: 3600
{%- else %}
  cwd: "{{ runtime_profile_dir }}/workspace"
  timeout: 180
  lifetime_seconds: 300
{%- endif %}

# =============================================================================
# Skills
# =============================================================================
skills:
  creation_nudge_interval: 0
  # Platform-native Alfred skills are deployed by the init container into
  # the profile's skills/ directory. The vault-worker skills
  # (vault-curator / vault-janitor / vault-distiller) are also synced there.

# =============================================================================
# Code execution sandbox
# =============================================================================
code_execution:
  timeout: 300
  max_tool_calls: 50

# =============================================================================
# Platform toolsets — which tools each surface may use
# =============================================================================
# This is the Hermes equivalent of OpenClaw's `gateway.tools.allow` array.
# The migrated allowlist: the OpenClaw allowlist was {message, sessions_*,
# ctrl_vault_*, ctrl_stream_ingest}. In Hermes the `sessions_*` primitives
# are subsumed by the `delegate_task` subagent tool and the run lifecycle;
# the `ctrl_*` surface is provided by the MCP servers below (auto-namespaced
# as mcp_alfred_ctrl_*). So the toolset list is the built-in capability set
# the profile is allowed to compose from. MCP tools are always available
# once their server is registered — toolsets gate only built-in tools.
platform_toolsets:
{%- if is_main %}
  # The user-facing Alfred: full built-in surface incl. messaging.
  cli: [hermes-cli]
  telegram: [hermes-telegram]
  slack: [hermes-slack]
  discord: [hermes-discord]
  whatsapp: [hermes-whatsapp]
  signal: [hermes-signal]
{%- elif profile == "codex-builder" %}
  # Sealed surface: terminal + file ONLY. No web (egress is iptables-
  # restricted, see docs/codex-builder-runtime.md §6), no skills (none
  # rendered into the profile dir), no todo (one-shot agent — no list to
  # maintain), no vision (no images in code reviews here), no delegation
  # (max_spawn_depth: 0 above is the hard fence; this is the soft one).
  # The agent has exactly one verb: run terminal commands in /work/runs.
  cli: [terminal, file]
{%- else %}
  # Workers: terminal + file + web + skills + todo + delegation. No
  # messaging toolset — workers never deliver to a channel directly
  # (notify_principal bridges through ctrl-api → the main profile).
  cli: [terminal, file, web, vision, skills, todo]
{%- endif %}

# =============================================================================
# MCP (Model Context Protocol) servers
# =============================================================================
{%- if profile == "codex-builder" %}
# codex-builder: explicitly empty. No ctrl-api, no Paperclip, no Plane,
# no Sure, no Vaultwarden, no execute, no Composio. The supervisor agent
# has zero MCP tools — its only verb is `terminal`. This is the hard
# fence per docs/codex-builder-runtime.md §6: any future operator who
# adds an MCP server here must justify why the sealed runtime should
# gain a new external reach.
mcp_servers: {}
{%- else %}
# Six servers, identical on both profiles — migrated verbatim from the
# OpenClaw `mcp.servers` block. One HTTP proxy + five stdio apps. Hermes
# auto-namespaces every tool as mcp_<server>_<tool>.
mcp_servers:

  # --- alfred-ctrl: HTTP proxy into this VM's ctrl-api ---------------------
  # A stdio MCP server (ctrl-server.mjs) that exposes the `self` tool — a
  # generic HTTP proxy to ctrl-api. On Alfred Prime it additionally exposes
  # the `tenant` and `ask_alfred` cross-tenant tools.
  alfred-ctrl:
    command: "node"
    args: ["{{ mcp_ctrl_script }}"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
      NODE_PATH: "{{ node_modules }}"
{%- if alfred_prime == "true" %}
      ALFRED_PRIME: "true"
{%- if cross_tenant_peers %}
      CROSS_TENANT_PEERS: '{{ cross_tenant_peers | safe }}'
{%- endif %}
{%- endif %}
    timeout: 120
    connect_timeout: 60

  # --- The 5-app stdio bundle ----------------------------------------------
  # Same tool catalogue the HTTP alfred-mcp-server exposes to claude.ai
  # Custom Connectors, served over stdio so the gateway can spawn each app
  # as a child process. Source: packages/mcp-server/src/bin/stdio-app.ts.
  alfred:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "alfred"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  sure:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "sure"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  plane:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "plane"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  vaultwarden:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "vaultwarden"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  execute:
    command: "node"
    args: ["{{ mcp_stdio_dir }}/dist/bin/stdio-app.js", "execute"]
    env:
      CTRL_API_URL: "{{ ctrl_api_url }}"
      AAS_API_KEY: "${AAS_API_KEY}"
    timeout: 120
    connect_timeout: 60

  # --- paperclip: Paperclip's first-party MCP server (paperclip.ing) -------
  # Wraps Paperclip's REST API as 48 stdio tools (companies, employees,
  # issues, projects, routines, approvals, …). Unlike the 5-app bundle
  # above — which lives in packages/mcp-server — paperclip is sourced
  # directly from upstream npm (@paperclipai/mcp-server, pinned in the
  # Hermes Dockerfile via PAPERCLIP_MCP_REF) so we don't reimplement 48
  # tools per Paperclip release. Trade-off documented in the Dockerfile +
  # the plan (Sir 2026-05-26, P1).
  #
  # PAPERCLIP_API_KEY is issued by Paperclip's better-auth UI on first
  # signup — NOT auto-generated. Until it's set in /opt/alfred/.env this
  # MCP server starts but every tool call 401s; the skill file routes the
  # principal to paperclip.<DOMAIN> Settings → API keys.
  paperclip:
    command: "node"
    args: ["/opt/paperclip-mcp/node_modules/@paperclipai/mcp-server/dist/stdio.js"]
    env:
      PAPERCLIP_API_URL: "http://paperclip:3100/api"
      # PAPERCLIP_API_KEY is the BOARD API KEY (pcp_board_…), minted by
      # bootstrap-paperclip.sh step 12 / migrate-paperclip-board-key.sh
      # and persisted into this profile's .env. NOT the agent token from
      # /opt/alfred/.env — that's the 2026-05-27 root-cause:
      # company-scoped MCP tools 403 with "Board access required" if
      # they're handed an agent token instead of a board key.
      PAPERCLIP_API_KEY: "${PAPERCLIP_API_KEY}"
      # PAPERCLIP_COMPANY_ID + PAPERCLIP_AGENT_ID let the MCP server
      # default the most common args (companyId, agentId) so the tools
      # work without the LLM having to know the UUIDs. Source:
      # /opt/alfred/.env (written by bootstrap-paperclip.sh step 11b);
      # bridged through this profile's .env via the same paperclip-init
      # path that wrote PAPERCLIP_API_KEY. If unset, the MCP tools
      # surface a clear "companyId is required because
      # PAPERCLIP_COMPANY_ID is not set" error.
      PAPERCLIP_COMPANY_ID: "${PAPERCLIP_COMPANY_ID}"
      PAPERCLIP_AGENT_ID: "${PAPERCLIP_AGENT_ID}"
    timeout: 120
    connect_timeout: 60
{%- endif %}{# end mcp_servers else (codex-builder gets mcp_servers: {} above) #}

{%- if is_main %}
# =============================================================================
# Gateway platforms — built-in messaging adapters
# =============================================================================
# Each `gateway.platforms.<name>` block opts that channel into Hermes' own
# gateway runtime. Credentials are loaded from env-var names declared here
# (never inlined) so they round-trip through the per-profile .env that
# ctrl-api's /channels cards write to.
#
# SMS — Hermes' built-in Twilio adapter (gateway/platforms/sms.py). Enabled
# here by default; ctrl-api's /channels SMS card stores Twilio credentials
# in Vaultwarden + writes them into this profile's .env, which Hermes reads
# on boot. The four `*_env` keys MUST match what the /channels card writes
# (TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER) and what
# render_hermes.py's _RUNTIME_KEY_PREFIXES preserves across re-renders.
# Webhook host/port default to Hermes' built-ins (8080) and can be
# overridden via SMS_WEBHOOK_HOST / SMS_WEBHOOK_PORT in the per-profile
# .env if a tenant needs to bind elsewhere — we deliberately don't hardcode
# them here so the Hermes default tracks whatever the adapter picks.
# Main-profile only: workers/heavy run no channels.
gateway:
  platforms:
    sms:
      enabled: true
      account_sid_env: TWILIO_ACCOUNT_SID
      auth_token_env: TWILIO_AUTH_TOKEN
      phone_number_env: TWILIO_PHONE_NUMBER
      allowed_users_env: SMS_ALLOWED_USERS

# =============================================================================
# Plugins (main profile only)
# =============================================================================
# hermes-lcm: lossless cross-session context engine. Replaces the default
# summarising context strategy with the LCM engine so the user-facing
# Alfred reloads prior session context without lossy compression. Plugin
# source is baked into the image at /opt/hermes-lcm (pinned SHA in
# Dockerfile) and supervisor.sh copies it into
# $HERMES_HOME/profiles/main/plugins/hermes-lcm at boot. Workers/heavy do
# not enable this — they are stateless / capped-concurrency.
#
# one-alfred: the user-facing continuity layer. Three hooks register
# against the gateway runtime (pre_gateway_dispatch + pre_llm_call +
# post_llm_call) — pre_gateway_dispatch injects ctrl-api's alfred_journal
# into Sir's inbound text before main processes it, so a delegate-
# completion message Alfred delivered earlier is in main's context when
# Sir replies (Sir perceives one continuous Alfred). pre/post_llm_call
# journal Sir's reply + main's response respectively for the audit
# trail. Plugin source is at /opt/one-alfred (COPY'd from
# packages/hermes/plugins/one-alfred in the Dockerfile) and the
# supervisor refreshes the install on every boot. Workers/heavy don't
# enable this — they don't speak to Sir directly.
# See packages/ctrl/docs/design/one-alfred.md.
plugins:
  enabled:
    - hermes-lcm
    - one-alfred

context:
  engine: lcm
{%- endif %}

# =============================================================================
# Display
# =============================================================================
display:
  compact: false
  tool_progress: {% if is_main %}all{% else %}new{% endif %}

  interim_assistant_messages: {% if is_main %}true{% else %}false{% endif %}

  streaming: true
