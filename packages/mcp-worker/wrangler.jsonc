{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alfred-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // McpAgent stores per-session state in a SQLite-backed Durable Object.
  // The binding name MUST be MCP_OBJECT — the SDK looks it up by that name.
  "durable_objects": {
    "bindings": [
      { "class_name": "SureMCP", "name": "MCP_OBJECT" }
    ]
  },

  // McpAgent requires the SQLite-backed DO storage backend, not the legacy
  // KV-backed one. Use `new_sqlite_classes`, NOT `new_classes`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SureMCP"] }
  ],

  // KV namespaces:
  //   OAUTH_KV     — OAuthProvider's runtime state (clients/grants/tokens)
  //   MCP_TENANTS  — multi-tenant routing config. Keyed on tenant_id (e.g.
  //                  "david"); value is the JSON described in src/tenants.ts
  //                  (ctrlUrl + aasApiKey + approvalSecret + label, plus
  //                  optional CF Access service-token credentials). Written
  //                  by the provisioner at tenant-ship time (#761 pattern).
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "ec8f6f9a0e424fbcaf10323a76ce8196" },
    { "binding": "MCP_TENANTS", "id": "bde5e3f32fac43b0a2c5d2814b9a3479" }
  ],

  // Bind the entire mcp.alfred.black subdomain to this Worker as a Custom
  // Domain. Cloudflare's Custom Domain feature does NOT accept wildcards or
  // paths (those are reserved for regular Worker routes), so we claim the
  // bare host. The Worker's fetch handler routes /mcp internally and
  // returns 404 for anything else (see src/index.ts).
  "routes": [
    { "pattern": "mcp.alfred.black", "custom_domain": true }
  ],

  "observability": { "enabled": true }

  // Secrets (set via `wrangler secret put`, never committed):
  //   COOKIE_ENCRYPTION_KEY — 32-byte hex; encrypts OAuthProvider state in KV
  //
  // Per-tenant config (ctrl URL, AAS API key, approval secret, etc.) now
  // lives in MCP_TENANTS KV instead of worker secrets. This lets new tenants
  // ship without redeploying the worker — the provisioner writes a row at
  // /api/v1/sure-style provision time.
}
