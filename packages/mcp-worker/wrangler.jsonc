{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alfred-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // McpAgent stores per-session state in a SQLite-backed Durable Object.
  // The binding name MUST be MCP_OBJECT — the SDK looks it up by that name.
  "durable_objects": {
    "bindings": [
      { "class_name": "SureMCP", "name": "MCP_OBJECT" }
    ]
  },

  // McpAgent requires the SQLite-backed DO storage backend, not the legacy
  // KV-backed one. Use `new_sqlite_classes`, NOT `new_classes`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SureMCP"] }
  ],

  // OAuth provider state — registered clients, grants, access tokens.
  // Required because Claude Custom Connectors UI rejects bearer-only servers
  // and instead expects the OAuth 2.1 + DCR flow advertised at
  // /.well-known/oauth-authorization-server. The library auto-stores grants
  // and clients here.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "ec8f6f9a0e424fbcaf10323a76ce8196" }
  ],

  // Bind the entire mcp.alfred.black subdomain to this Worker as a Custom
  // Domain. Cloudflare's Custom Domain feature does NOT accept wildcards or
  // paths (those are reserved for regular Worker routes), so we claim the
  // bare host. The Worker's fetch handler routes /mcp internally and
  // returns 404 for anything else (see src/index.ts).
  "routes": [
    { "pattern": "mcp.alfred.black", "custom_domain": true }
  ],

  "observability": { "enabled": true }

  // Secrets (set via `wrangler secret put`, never committed):
  //   MCP_APPROVAL_SECRET          — pre-shared secret Sir enters once on /authorize to approve a new Claude
  //                                   Custom Connector registration (single-tenant gate)
  //   COOKIE_ENCRYPTION_KEY        — 32-byte hex; encrypts the OAuthProvider's client/grant cookies in KV
  //   DAVID_AAS_API_KEY            — david's ctrl-api bearer
  //   DAVID_CTRL_URL               — base URL of david's ctrl-api (e.g. https://alfred-david-mnbqn4jg.alfred.black)
  //   DAVID_CF_ACCESS_CLIENT_ID    — OPTIONAL Cloudflare Access service-token client id (subdomain has no Access today)
  //   DAVID_CF_ACCESS_CLIENT_SECRET — OPTIONAL Cloudflare Access service-token secret
}
