{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openai/gpt-5.4-nano"
      },
      "contextLimits": {
        "toolResultMaxChars": 160000
      },
      "bootstrapMaxChars": 40000,
      "bootstrapTotalMaxChars": 200000,
      "subagents": {
        "allowAgents": ["*"]
      }
    },
    "list": [
      {
        "id": "learn-clerk",
        "name": "Learn Clerk",
        "model": {"primary": "openrouter/openai/gpt-5.4-nano"},
        "workspace": "/home/node/.openclaw/workspace",
        "subagents": { "allowAgents": ["*"] }
      },
      {
        "id": "vault-curator",
        "name": "Vault Curator",
        "model": {"primary": "openrouter/openai/gpt-5.4-nano"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-distiller",
        "name": "Vault Distiller",
        "model": {"primary": "openrouter/openai/gpt-5.4-nano"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-janitor",
        "name": "Vault Janitor",
        "model": {"primary": "openrouter/openai/gpt-5.4-nano"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-surveyor",
        "name": "Vault Surveyor",
        "model": {"primary": "openrouter/openai/gpt-5.4-nano"},
        "workspace": "/home/node/.openclaw/workspace"
      }
    ]
  },
  "memory": {
    "backend": "builtin",
    "citations": "off"
  },
  "gateway": {
    "port": 18790,
    "bind": "lan",
    "auth": {
      "mode": "token",
      {% if gateway_token %}"token": "{{ gateway_token }}",{% endif %}
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": false
    },
    "tools": {
      "allow": ["message", "sessions_send", "sessions_spawn", "sessions_history", "sessions_list", "sessions_delete", "ctrl_vault_read", "ctrl_vault_create", "ctrl_vault_update", "ctrl_vault_search", "ctrl_vault_list", "ctrl_stream_ingest"]
    }
  },
  "tools": {
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": ["*"]
    }
  }
}
