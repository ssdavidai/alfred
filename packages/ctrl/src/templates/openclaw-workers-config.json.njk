{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5"
      },
      "subagents": {
        "model": "anthropic/claude-haiku-4-5"
      }
    },
    "list": [
      {
        "id": "learn-clerk",
        "name": "Learn Clerk",
        "model": {"primary": "anthropic/claude-haiku-4-5"},
        "workspace": "/home/node/.openclaw/workspace",
        "subagents": { "allowAgents": ["*"] }
      },
      {
        "id": "vault-curator",
        "name": "Vault Curator",
        "model": {"primary": "anthropic/claude-haiku-4-5"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-distiller",
        "name": "Vault Distiller",
        "model": {"primary": "anthropic/claude-haiku-4-5"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-janitor",
        "name": "Vault Janitor",
        "model": {"primary": "anthropic/claude-haiku-4-5"},
        "workspace": "/home/node/.openclaw/workspace"
      },
      {
        "id": "vault-surveyor",
        "name": "Vault Surveyor",
        "model": {"primary": "anthropic/claude-haiku-4-5"},
        "workspace": "/home/node/.openclaw/workspace"
      }
    ]
  },
  "memory": {
    "backend": "qmd",
    "citations": "auto",
    "qmd": {
      "searchMode": "search",
      "includeDefaultMemory": true,
      "paths": [
        {"path": "{{ vault_path }}", "name": "vault", "pattern": "**/*.md"}
      ],
      "update": {"interval": "5m", "debounceMs": 15000, "onBoot": true},
      "limits": {"maxResults": 8, "timeoutMs": 5000}
    }
  },
  "gateway": {
    "port": 18790,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": false
    },
    "tools": {
      "allow": ["sessions_send", "sessions_spawn", "sessions_history", "sessions_list", "sessions_delete", "ctrl_vault_read", "ctrl_vault_create", "ctrl_vault_update", "ctrl_vault_search", "ctrl_vault_list", "ctrl_stream_ingest"]
    }
  },
  "tools": {
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": ["*"]
    }
  }
}
