services:
  init:
    image: ssdavidai00/alfred-init:latest
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/openclaw:/openclaw-state
      - /mnt/encrypted/alfred:/alfred-data
    env_file:
      - .env

  temporal:
    image: temporalio/temporal:latest
    command: ["server", "start-dev", "--db-filename", "/data/temporal.db", "--ip", "0.0.0.0", "--port", "7233", "--ui-port", "8233"]
    volumes:
      - /mnt/encrypted/temporal:/data
    ports:
      - "127.0.0.1:7233:7233"
      - "127.0.0.1:8233:8233"
    healthcheck:
      test: ["CMD-SHELL", "temporal operator cluster health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    mem_limit: 2g
    pids_limit: 256

  openclaw:
    image: ssdavidai00/alfred-openclaw:latest
    depends_on:
      init:
        condition: service_completed_successfully
      temporal:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/openclaw:/home/node/.openclaw
      - /mnt/encrypted/vault:/home/node/.openclaw/workspace/vault
      - /mnt/encrypted/alfred:/alfred-data
    ports:
      - "127.0.0.1:18789:18789"
    environment:
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - NODE_OPTIONS=--max-old-space-size=3072
    env_file:
      - .env
    command: ["node", "openclaw.mjs", "gateway", "--bind", "lan", "--port", "18789", "--allow-unconfigured"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18789/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    mem_limit: 4g
    pids_limit: 256

  alfred:
    image: ssdavidai00/alfred-worker:latest
    depends_on:
      openclaw:
        condition: service_healthy
      init:
        condition: service_completed_successfully
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/app/data
      - /mnt/encrypted/openclaw:/root/.openclaw
    environment:
      - OPENCLAW_GATEWAY_URL=ws://openclaw:18789
    env_file:
      - .env
    entrypoint: ["bash", "-c", "rm -f /app/data/alfred.pid && exec /app/entrypoint.sh"]
    command: []
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 2g
    pids_limit: 256

  alfred-learn:
    image: ssdavidai00/alfred-learn:latest
    depends_on:
      temporal:
        condition: service_healthy
      openclaw:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - TEMPORAL_HOST=temporal:7233
      - OPENCLAW_GATEWAY_URL=http://openclaw:18789
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - VAULT_PATH=/vault
      - TASK_QUEUE=alfred-learn
      - ALFRED_LEARN_ENABLED=${ALFRED_LEARN_ENABLED:-true}
      - ALFRED_CTRL_URL=http://host.docker.internal:3100
    env_file:
      - .env
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 1g
    pids_limit: 128
