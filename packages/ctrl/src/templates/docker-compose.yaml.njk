# Image tag strategy: all custom images intentionally use :latest.
# Version management is handled by the alfred-update.timer systemd unit on each tenant,
# which runs `docker compose pull && docker compose up -d` on a schedule.
# This rolling update mechanism ensures tenants stay current without manual intervention.
# Pinning to SHA or semver tags here would require reprovisioning or manual ssh to update each tenant.
services:
  init:
    image: ssdavidai00/alfred-init:latest
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/openclaw:/openclaw-state
      - /mnt/encrypted/openclaw-workers:/openclaw-workers-state
      - /mnt/encrypted/alfred:/alfred-data
    env_file:
      - .env

  temporal:
    # temporalio/temporal is also kept at :latest so alfred-update.timer picks up patch releases automatically.
    #
    # blobSize / historySize bumps from defaults (2MB warn / 4MB error blob,
    # 50MB / 50K events history) up to 16MB / 8MB blob and 200MB / 100K
    # history. Driven by the composio_pull activity returning Gmail
    # responses with full HTML bodies — at max_results=30 a busy tenant's
    # response was hitting Temporal's 4MB blob limit, the activity
    # `composio_pull` failed nonRetryable with "Complete result exceeds
    # size limit", the schedule kept firing every 5 min but `last_pull_at`
    # never advanced, and Gmail went stale for 22+ hours on Rapali before
    # the daily-brief skill's stream-pull-health check surfaced it. Same
    # class of failure can hit any high-fanout activity (Plane sync, Notion
    # backfill, large vault list responses), so the fix is applied at the
    # Temporal layer rather than per-activity truncation that would lose
    # user data.
    image: temporalio/temporal:latest
    command:
      - "server"
      - "start-dev"
      - "--db-filename"
      - "/data/temporal.db"
      - "--ip"
      - "0.0.0.0"
      - "--port"
      - "7233"
      - "--ui-port"
      - "8233"
      - "--dynamic-config-value"
      - "limit.blobSize.warn=8388608"
      - "--dynamic-config-value"
      - "limit.blobSize.error=16777216"
      - "--dynamic-config-value"
      - "limit.historySize.warn=104857600"
      - "--dynamic-config-value"
      - "limit.historySize.error=209715200"
      - "--dynamic-config-value"
      - "limit.historyCount.warn=51200"
      - "--dynamic-config-value"
      - "limit.historyCount.error=102400"
      - "--dynamic-config-value"
      - "frontend.rpc.maxReceivedMessageSize=33554432"
      - "--dynamic-config-value"
      - "history.rpc.maxReceivedMessageSize=33554432"
    volumes:
      - /mnt/encrypted/temporal:/data
    ports:
      - "127.0.0.1:7233:7233"
      - "127.0.0.1:8233:8233"
    healthcheck:
      test: ["CMD-SHELL", "temporal operator cluster health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    mem_limit: 2g
    # Bumped from 256 → 1024 (2026-04-24). Temporal's Go runtime multiplexes
    # goroutines onto OS threads (M:N scheduler), and under fleet load —
    # many concurrent workflow executions + SQLite background writers +
    # HTTP/2 streams to the UI — 256 was exhausting the pid budget with
    # ``runtime: failed to create new OS thread (have 2 already; errno=11)``
    # on miguel + rapali. Live-patched via `docker update --pids-limit`
    # on david/miguel/rapali; this bakes the fix into the template so the
    # starvation doesn't return on container recreate.
    pids_limit: 1024

  ollama:
    # Local embedding server for surveyor (and future local-LLM uses).
    # On startup: boots ollama, waits for ready, pulls nomic-embed-text
    # (~275MB, 768 dims). `ollama pull` is idempotent — skips if the model
    # is already in the persistent volume.
    image: ollama/ollama:latest
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        ollama serve &
        SERVE_PID=$$!
        until ollama list >/dev/null 2>&1; do sleep 1; done
        ollama pull nomic-embed-text || echo "[ollama] pull failed, will retry next boot"
        wait $$SERVE_PID
    volumes:
      - /mnt/encrypted/ollama:/root/.ollama
    ports:
      - "127.0.0.1:11434:11434"
    healthcheck:
      test: ["CMD-SHELL", "ollama list >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 120s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    mem_limit: 2g
    # Bumped from 256 → 512 (2026-04-24). Ollama's runtime spawns a pytorch
    # threadpool sized to CPU count for embedding inference; with surveyor
    # batching requests every few minutes 256 was too tight.
    pids_limit: 512

  openclaw:
    image: ssdavidai00/alfred-openclaw:latest
    depends_on:
      init:
        condition: service_completed_successfully
      temporal:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/openclaw:/home/node/.openclaw
      - /mnt/encrypted/openclaw/qmd-cache:/home/node/.cache/qmd
      - /mnt/encrypted/vault:/home/node/.openclaw/workspace/vault
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
    tmpfs:
      - /tmp:size=256m
    ports:
      - "127.0.0.1:18789:18789"
    environment:
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - NODE_OPTIONS=--max-old-space-size=3072
    env_file:
      - .env
    command: ["sh", "-c", "node -e \"const fs=require('fs'),p='/home/node/.openclaw/agents',src=p+'/main/agent/auth-profiles.json';if(fs.existsSync(src)){const d=fs.readFileSync(src,'utf8');fs.readdirSync(p).forEach(a=>{if(a==='main')return;const dir=p+'/'+a+'/agent',dest=dir+'/auth-profiles.json';if(!fs.existsSync(dest)){fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(dest,d);console.log('auth-profiles propagated to '+a)}})}\" 2>/dev/null; exec node openclaw.mjs gateway --bind lan --port 18789 --allow-unconfigured"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18789/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    mem_limit: 4g
    # Bumped from 256 → 2048 (2026-04-24) to match openclaw-workers (see
    # #593 reasoning below). Main gateway has the same PID spawn profile
    # — healthcheck fork every 10s + MCP subprocesses + ephemeral session
    # nodes — and fronts all user-facing traffic (Slack DMs, webchat,
    # email, voice), so it needs the same headroom.
    pids_limit: 2048

  openclaw-workers:
    image: ssdavidai00/alfred-openclaw:latest
    depends_on:
      init:
        condition: service_completed_successfully
      temporal:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/openclaw-workers:/home/node/.openclaw
      - /mnt/encrypted/openclaw-workers/qmd-cache:/home/node/.cache/qmd
      - /mnt/encrypted/vault:/home/node/.openclaw/workspace/vault
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
    tmpfs:
      - /tmp:size=256m
    environment:
      # Heap bumped to 4096 (from 3072) to give headroom for the openclaw
      # gateway's `loadTaskRegistryStateFromSqlite`, which does an unbounded
      # `SELECT * FROM task_runs` + `SELECT * FROM flow_runs` on boot. On a
      # busy worker queue (e.g. David at ~1700 task_runs/day with ~136KB
      # avg `task` column) the materialized UTF-16 string heap can exceed
      # 3GB within ~7 days. 4GB heap → ~14 days of headroom against the
      # default cleanup_after retention window. See issue for the upstream
      # fix (LIMIT + streaming load) + in-tenant periodic prune follow-up.
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - NODE_OPTIONS=--max-old-space-size=4096
    env_file:
      - .env
    command: ["node", "openclaw.mjs", "gateway", "--bind", "lan", "--port", "18790", "--allow-unconfigured"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18790/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    # mem_limit matches heap ceiling + ~2G for RSS overhead (native sqlite,
    # v8 metadata, code, libuv buffers). Raised from 4g to 6g in lockstep
    # with NODE_OPTIONS bump above.
    mem_limit: 6g
    # 256 was saturation-prone: the gateway spawns a fresh node PID per
    # healthcheck (every 10s) + per ephemeral session + per MCP subprocess,
    # and exhaustion manifests as `uv_thread_create` assertion failures that
    # crash the healthcheck while the main process keeps running → container
    # stuck `Up (unhealthy)` blocking depends_on gates.
    pids_limit: 2048

  alfred:
    image: ssdavidai00/alfred-worker:latest
    depends_on:
      openclaw-workers:
        condition: service_healthy
      ctrl-api:
        condition: service_healthy
      init:
        condition: service_completed_successfully
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/app/data
      - /mnt/encrypted/openclaw-workers:/root/.openclaw
    tmpfs:
      - /tmp:size=256m
    environment:
      # alfred (vault daemon) calls openclaw-wrapper which spawns
      # vault-curator/janitor/distiller subagents via sessions_spawn.
      # These subagents MUST run on the workers gateway, NOT main:
      # - workers is where the agents (vault-curator etc.) are defined
      # - workers' auto-announce on subagent completion lands inside
      #   workers gateway and never touches main's user-facing session
      # - PR #715 wrongly pointed this at main to bypass an
      #   "agentId is not allowed for sessions_spawn (allowed: none)"
      #   error on workers; the actual fix is to set workers'
      #   agents.defaults.subagents.allowAgents=["*"] (see
      #   openclaw-workers-config.json.njk), which permits external
      #   spawns. Pre-revert, vault-curator subagent completions were
      #   announced to agent:main:main and dumped 84K tokens of
      #   curator-skill text into Sir's chat session per fire,
      #   causing context overflow on his Slack/Telegram conversations.
      - OPENCLAW_GATEWAY_URL=http://openclaw-workers:18790
      - ALFRED_CTRL_URL=http://ctrl-api:3100
    env_file:
      - .env
    entrypoint: ["bash", "-c", "rm -f /app/data/alfred.pid && set -a && [ -f /app/data/.env ] && source /app/data/.env; [ -f /app/data/.gateway-token ] && export OPENCLAW_GATEWAY_TOKEN=$(cat /app/data/.gateway-token); set +a && exec alfred --config /app/data/config.yaml up --foreground"]
    command: []
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
      - FOWNER
      - CHOWN
    mem_limit: 2g
    # Bumped from 256 → 512 (2026-04-24). The alfred worker runs multiple
    # long-lived daemon processes (curator, janitor, distiller, surveyor)
    # plus periodic child processes for vault CLI calls, embedding
    # generation via ollama, and openclaw gateway sessions.
    pids_limit: 512

  ctrl-api:
    image: node:22-slim
    depends_on:
      init:
        condition: service_completed_successfully
    volumes:
      - /opt/alfred/api.mjs:/app/api.mjs:ro
      - /opt/alfred:/opt/alfred
      - /mnt/encrypted/vault:/mnt/encrypted/vault
      - /mnt/encrypted/alfred:/mnt/encrypted/alfred
      - /mnt/encrypted/openclaw:/mnt/encrypted/openclaw
      - /mnt/encrypted/openclaw-workers:/mnt/encrypted/openclaw-workers
      - /opt/alfred/compose:/opt/alfred/compose
      - /var/run/docker.sock:/var/run/docker.sock
      - /usr/bin/docker:/usr/bin/docker:ro
      - /usr/libexec/docker/cli-plugins:/usr/libexec/docker/cli-plugins:ro
    working_dir: /opt/alfred/compose
    command: ["bash", "-c", "apt-get update -qq && apt-get install -y -qq procps jq curl python3-yaml >/dev/null 2>&1; exec node --max-old-space-size=768 /app/api.mjs"]
    env_file:
      - .env
    environment:
      - AAS_HOST=0.0.0.0
      - AAS_PORT=3100
      - NODE_ENV=production
      # AgentMail channels/email inbound needs the openclaw gateway token to
      # spawn an agent session. The file lives on the shared /mnt/encrypted/alfred
      # mount (same path inside this container — we don't remap to /alfred-data
      # here like alfred-learn does).
      - OPENCLAW_GATEWAY_TOKEN_FILE=/mnt/encrypted/alfred/.gateway-token
    ports:
      - "127.0.0.1:3100:3100"
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:3100/api/v1/learning/status -H \"Authorization: Bearer $AAS_API_KEY\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    mem_limit: 1g
    # Higher pids_limit than peer services because ctrl-api fronts all
    # docker-exec traffic into the alfred container (vault writes, worker
    # operations, chore runs). Under fleet load — plane forward+reverse
    # sync, hourly_enrichment, composio sync, stream pullers — 256 was
    # saturating the fork budget and surfacing as 500s with
    # ``fork/exec … resource temporarily unavailable`` or the more
    # confusing ``unknown shorthand flag: 'f' in -f`` when the compose
    # plugin failed to load mid-parse (see #593). 1024 leaves headroom
    # above the 8-way in-process semaphore in helpers.ts while staying
    # safely below the host's default 32k cap.
    pids_limit: 1024

  alfred-learn:
    image: ssdavidai00/alfred-learn:latest
    depends_on:
      temporal:
        condition: service_healthy
      openclaw-workers:
        condition: service_healthy
      ctrl-api:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
      - /mnt/encrypted/openclaw-workers:/openclaw-workers-state
    environment:
      - TEMPORAL_HOST=temporal:7233
      # alfred-learn talks to BOTH gateways:
      #
      # * OPENCLAW_GATEWAY_URL → MAIN (:18789). Used by notify_eod_prompt,
      #   the Plane @alfred trigger spawn (agentId=main), and any other
      #   user-facing Alfred session. The workers gateway rejects
      #   agentId=main, so this MUST NOT point at :18790.
      # * OPENCLAW_WORKERS_GATEWAY_URL → WORKERS (:18790). Used by clerk
      #   (agentId=learn-clerk) and task execution subagents.
      #
      # EXECUTION_GATEWAY_URL is the older name for the same workers
      # endpoint, consumed by the ephemeral-subagent activity stack
      # (chore_actions.py, ephemeral_agent.py).
      - OPENCLAW_GATEWAY_URL=http://openclaw:18789
      - OPENCLAW_WORKERS_GATEWAY_URL=http://openclaw-workers:18790
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - VAULT_PATH=/vault
      - TASK_QUEUE=alfred-learn
      - ALFRED_LEARN_ENABLED=${ALFRED_LEARN_ENABLED:-true}
      - ALFRED_CTRL_URL=http://ctrl-api:3100
      - SAAS_API_URL=https://alfred.black
      - WORKERS_OPENCLAW_CONFIG=/openclaw-workers-state/openclaw.json
      - EXECUTION_GATEWAY_URL=http://openclaw-workers:18790
    env_file:
      - .env
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 4g
    # Bumped from 128 → 512 (2026-04-24). alfred-learn runs the Temporal
    # Python worker which spawns threads per activity execution, plus
    # httpx connection pools per workflow (EventProcessor, Hourly
    # Enrichment, Daily Digest, Judgment, Reflection all active
    # concurrently). 128 was the tightest budget in the stack and was
    # saturating under the zero-LLM ingest + hourly enrichment pattern
    # that landed in #394/#395.
    pids_limit: 512

{% if plane_enabled %}
  # ── Plane self-hosted PM (stable) ───────────────────────────────────
  # Opt-in sidecar stack (see issue #536). All services bind to the internal
  # compose network; external reach-in is only via plane-proxy:8080 which the
  # provisioner's setup_plane step then talks to over localhost.
  #
  # Secrets (DJANGO_SECRET_KEY, REDIS_PASSWORD, POSTGRES_PASSWORD,
  # MINIO_ROOT_PASSWORD, PLANE_WEBHOOK_SECRET, PLANE_ADMIN_EMAIL,
  # PLANE_ADMIN_PASSWORD, PLANE_API_TOKEN, PLANE_WORKSPACE_SLUG,
  # PLANE_ALFRED_USER_ID) all live in /opt/alfred/compose/.env — generated by
  # the provisioner post-boot, never in cloud-init. Interpolated here via
  # docker compose's ${VAR} syntax from env_file.

  plane-db:
    image: postgres:15.7-alpine
    restart: unless-stopped
    environment:
      - POSTGRES_DB=plane
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - PGDATA=/var/lib/postgresql/data
    volumes:
      - /mnt/encrypted/plane/pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U plane -d plane"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 1g
    pids_limit: 512

  plane-redis:
    image: valkey/valkey:7.2.11-alpine
    restart: unless-stopped
    command: ["valkey-server", "--requirepass", "${REDIS_PASSWORD}", "--appendonly", "yes"]
    volumes:
      - /mnt/encrypted/plane/redis:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a ${REDIS_PASSWORD} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 15s
    mem_limit: 256m
    pids_limit: 512

  plane-mq:
    image: rabbitmq:3.13-management-alpine
    restart: unless-stopped
    environment:
      - RABBITMQ_DEFAULT_USER=plane
      - RABBITMQ_DEFAULT_PASS=${REDIS_PASSWORD}
      - RABBITMQ_DEFAULT_VHOST=plane
    volumes:
      - /mnt/encrypted/plane/rabbitmq:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD-SHELL", "rabbitmq-diagnostics -q ping"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 30s
    mem_limit: 512m
    pids_limit: 512

  plane-minio:
    image: minio/minio:latest
    restart: unless-stopped
    command: ["server", "/export", "--console-address", ":9090"]
    environment:
      - MINIO_ROOT_USER=plane
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
    volumes:
      - /mnt/encrypted/plane/uploads:/export
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/minio/health/live || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 256m
    pids_limit: 512

  # One-shot migrator. plane-api's entrypoint calls `wait_for_migrations` which
  # blocks until `python manage.py migrate` has run — Plane's official compose
  # factors this into a dedicated service so the api/worker/beat don't each try
  # to apply migrations on boot (which caused deadlock during the first deploy
  # attempt on david, issue #555).
  plane-migrator:
    image: makeplane/plane-backend:stable
    restart: "no"
    depends_on:
      plane-db:
        condition: service_healthy
      plane-redis:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - POSTGRES_HOST=plane-db
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-migrator.sh"]
    mem_limit: 512m
    pids_limit: 512

  plane-api:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-db:
        condition: service_healthy
      plane-redis:
        condition: service_healthy
      plane-mq:
        condition: service_healthy
      plane-minio:
        condition: service_healthy
      plane-migrator:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - POSTGRES_HOST=plane-db
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
      - USE_MINIO=1
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_S3_BUCKET_NAME=uploads
      - AWS_REGION=us-east-1
      - WEB_URL=http://plane-proxy:8080
      - ENABLE_SIGNUP=0
      - ENABLE_EMAIL_PASSWORD=1
      - ENABLE_MAGIC_LINK_LOGIN=0
      - API_KEY_RATE_LIMIT=600/minute
      - GUNICORN_WORKERS=2
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-api.sh"]
    networks:
      default:
        aliases:
          - api
    healthcheck:
      # plane-backend image ships wget but NOT curl.
      # wget resolves "localhost" to ::1 first but gunicorn binds IPv4 only,
      # so use 127.0.0.1 explicitly. The root endpoint returns {"status":"OK"}.
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8000/ >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 120s
    mem_limit: 1g
    pids_limit: 512

  plane-worker:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
      plane-migrator:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_HOST=plane-db
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
      - USE_MINIO=1
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_S3_BUCKET_NAME=uploads
      - AWS_REGION=us-east-1
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-worker.sh"]
    # 1g was OOM-killed on boot (celery + bgtask registry). 2g holds steady.
    mem_limit: 2g
    pids_limit: 512

  plane-beat:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
      plane-migrator:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_HOST=plane-db
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-beat.sh"]
    mem_limit: 256m
    pids_limit: 512

  plane-web:
    # plane-frontend:stable is a pre-built nginx image serving static Next.js
    # export. Image ships its own /etc/nginx/nginx.conf with `listen 3000;`
    # (NOT :80 — the /etc/nginx/conf.d/default.conf stub is unused). CMD is
    # `nginx -g daemon off;` — do not override.
    image: makeplane/plane-frontend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    networks:
      default:
        aliases:
          - web
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    mem_limit: 512m
    pids_limit: 512

  plane-space:
    # plane-space:stable runs `npx react-router-serve ./build/server/index.js`
    # on :3000 via its own entrypoint — don't override CMD.
    image: makeplane/plane-space:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    networks:
      default:
        aliases:
          - space
    mem_limit: 256m
    pids_limit: 512

  plane-admin:
    # plane-admin:stable is nginx on :80, same pattern as plane-web.
    image: makeplane/plane-admin:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    networks:
      default:
        aliases:
          - admin
    mem_limit: 256m
    pids_limit: 512

  plane-live:
    image: makeplane/plane-live:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - API_BASE_URL=http://plane-api:8000
      - LIVE_BASE_PATH=/live
      - LIVE_SERVER_SECRET_KEY=${LIVE_SERVER_SECRET_KEY}
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
    networks:
      default:
        aliases:
          - live
    mem_limit: 256m
    pids_limit: 512

  plane-proxy:
    image: makeplane/plane-proxy:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
      plane-web:
        condition: service_healthy
    ports:
      - "127.0.0.1:8080:80"
    environment:
      # Caddyfile globals need SITE_ADDRESS populated or the empty-brace `{ ... }`
      # block gets re-parsed as a second "server block without any key", which
      # Caddy rejects ("global configuration, if used, must be first"). `:80` makes
      # the Caddyfile a plain-HTTP listener with no ACME, which matches how we
      # expose plane-proxy — bound to 127.0.0.1:8080 only, no public TLS.
      # TRUSTED_PROXIES silences a separate global-config warning. See B9 on
      # david 2026-04-23.
      - SITE_ADDRESS=:80
      - TRUSTED_PROXIES=0.0.0.0/0
      - FILE_SIZE_LIMIT=5242880
      - BUCKET_NAME=uploads
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:80/ >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    mem_limit: 128m
    pids_limit: 512
{% endif %}

{% if sure_enabled %}
  # ── Sure self-hosted personal-finance (stable) ──────────────────────
  # Sidecar stack mirroring the Plane block above. Default-on for every
  # tenant (alongside Plane). Public reach-in is via cloudflared:
  # <subdomain>-sure.alfred.black → 127.0.0.1:3001 → sure-web :3000.
  #
  # Env-var names (DB_HOST, DB_PORT, POSTGRES_USER, POSTGRES_PASSWORD,
  # POSTGRES_DB, REDIS_URL, SECRET_KEY_BASE, SELF_HOSTED, RAILS_*) come
  # from the upstream compose.example.yml in we-promise/sure — do not
  # rename. Sure-specific secrets (SURE_POSTGRES_PASSWORD,
  # SURE_REDIS_PASSWORD, SURE_SECRET_KEY_BASE) live in
  # /opt/alfred/compose/.env, generated by the provisioner's setupSure
  # step. They are NOT shared with Plane's POSTGRES_PASSWORD /
  # REDIS_PASSWORD — each sidecar owns its own datastore credentials.

  sure-db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      - POSTGRES_DB=sure
      - POSTGRES_USER=sure
      - POSTGRES_PASSWORD=${SURE_POSTGRES_PASSWORD}
      - PGDATA=/var/lib/postgresql/data
    volumes:
      - /mnt/encrypted/sure/pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sure -d sure"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 1g
    pids_limit: 512

  sure-redis:
    image: valkey/valkey:7.2.11-alpine
    restart: unless-stopped
    command: ["valkey-server", "--requirepass", "${SURE_REDIS_PASSWORD}", "--appendonly", "yes"]
    volumes:
      - /mnt/encrypted/sure/redis:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a ${SURE_REDIS_PASSWORD} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 15s
    mem_limit: 256m
    pids_limit: 512

  sure-web:
    image: ghcr.io/we-promise/sure:stable
    restart: unless-stopped
    depends_on:
      sure-db:
        condition: service_healthy
      sure-redis:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - SECRET_KEY_BASE=${SURE_SECRET_KEY_BASE}
      - SELF_HOSTED=true
      - RAILS_ENV=production
      - RAILS_FORCE_SSL=false
      - RAILS_ASSUME_SSL=false
      - DB_HOST=sure-db
      - DB_PORT=5432
      - POSTGRES_DB=sure
      - POSTGRES_USER=sure
      - POSTGRES_PASSWORD=${SURE_POSTGRES_PASSWORD}
      - REDIS_URL=redis://:${SURE_REDIS_PASSWORD}@sure-redis:6379/0
    # Mount /alfred-data so ctrl-api's Rails-runner-backed account CRUD
    # endpoints can hand sure-web a JSON payload via the shared volume.
    # Same path the sure-init one-shot uses; long-running sure-web reads
    # the script + payload on demand for create/update/delete.
    volumes:
      - /mnt/encrypted/alfred:/alfred-data
    ports:
      - "127.0.0.1:3001:3000"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:3000/up >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 120s
    mem_limit: 2g
    pids_limit: 512

  sure-worker:
    image: ghcr.io/we-promise/sure:stable
    restart: unless-stopped
    depends_on:
      sure-db:
        condition: service_healthy
      sure-redis:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - SECRET_KEY_BASE=${SURE_SECRET_KEY_BASE}
      - SELF_HOSTED=true
      - RAILS_ENV=production
      - RAILS_FORCE_SSL=false
      - RAILS_ASSUME_SSL=false
      - DB_HOST=sure-db
      - DB_PORT=5432
      - POSTGRES_DB=sure
      - POSTGRES_USER=sure
      - POSTGRES_PASSWORD=${SURE_POSTGRES_PASSWORD}
      - REDIS_URL=redis://:${SURE_REDIS_PASSWORD}@sure-redis:6379/0
    command: ["bundle", "exec", "sidekiq"]
    mem_limit: 1g
    pids_limit: 512

  # One-shot bootstrap. Reuses the sure-web image because it needs Rails +
  # Postgres credentials. Waits for sure-web's /up endpoint via depends_on,
  # then runs bootstrap.rb (staged into /alfred-data by the alfred-init
  # container's step 12). Idempotent — rerunning is safe; the Ruby script
  # short-circuits if /alfred-data/.sure-api-key already exists.
  sure-init:
    image: ghcr.io/we-promise/sure:stable
    depends_on:
      sure-web:
        condition: service_healthy
      init:
        condition: service_completed_successfully
    env_file:
      - .env
    environment:
      - SECRET_KEY_BASE=${SURE_SECRET_KEY_BASE}
      - SELF_HOSTED=true
      - RAILS_ENV=production
      - DB_HOST=sure-db
      - DB_PORT=5432
      - POSTGRES_DB=sure
      - POSTGRES_USER=sure
      - POSTGRES_PASSWORD=${SURE_POSTGRES_PASSWORD}
      - REDIS_URL=redis://:${SURE_REDIS_PASSWORD}@sure-redis:6379/0
    volumes:
      - /mnt/encrypted/alfred:/alfred-data
    entrypoint: ["bin/rails", "runner", "/alfred-data/sure-bootstrap/bootstrap.rb"]
    restart: "no"
    mem_limit: 512m
    pids_limit: 256
{% endif %}

volumes: {}
