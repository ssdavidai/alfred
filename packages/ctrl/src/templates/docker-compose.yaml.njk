# Image tag strategy: all custom images intentionally use :latest.
# Version management is handled by the alfred-update.timer systemd unit on each tenant,
# which runs `docker compose pull && docker compose up -d` on a schedule.
# This rolling update mechanism ensures tenants stay current without manual intervention.
# Pinning to SHA or semver tags here would require reprovisioning or manual ssh to update each tenant.
services:
  init:
    image: ssdavidai00/alfred-init:latest
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/openclaw:/openclaw-state
      - /mnt/encrypted/openclaw-workers:/openclaw-workers-state
      - /mnt/encrypted/alfred:/alfred-data
    env_file:
      - .env

  temporal:
    # temporalio/temporal is also kept at :latest so alfred-update.timer picks up patch releases automatically.
    image: temporalio/temporal:latest
    command: ["server", "start-dev", "--db-filename", "/data/temporal.db", "--ip", "0.0.0.0", "--port", "7233", "--ui-port", "8233"]
    volumes:
      - /mnt/encrypted/temporal:/data
    ports:
      - "127.0.0.1:7233:7233"
      - "127.0.0.1:8233:8233"
    healthcheck:
      test: ["CMD-SHELL", "temporal operator cluster health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    mem_limit: 2g
    pids_limit: 256

  ollama:
    # Local embedding server for surveyor (and future local-LLM uses).
    # On startup: boots ollama, waits for ready, pulls nomic-embed-text
    # (~275MB, 768 dims). `ollama pull` is idempotent — skips if the model
    # is already in the persistent volume.
    image: ollama/ollama:latest
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        ollama serve &
        SERVE_PID=$$!
        until ollama list >/dev/null 2>&1; do sleep 1; done
        ollama pull nomic-embed-text || echo "[ollama] pull failed, will retry next boot"
        wait $$SERVE_PID
    volumes:
      - /mnt/encrypted/ollama:/root/.ollama
    ports:
      - "127.0.0.1:11434:11434"
    healthcheck:
      test: ["CMD-SHELL", "ollama list >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 120s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    mem_limit: 2g
    pids_limit: 256

  openclaw:
    image: ssdavidai00/alfred-openclaw:latest
    depends_on:
      init:
        condition: service_completed_successfully
      temporal:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/openclaw:/home/node/.openclaw
      - /mnt/encrypted/openclaw/qmd-cache:/home/node/.cache/qmd
      - /mnt/encrypted/vault:/home/node/.openclaw/workspace/vault
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
    tmpfs:
      - /tmp:size=256m
    ports:
      - "127.0.0.1:18789:18789"
    environment:
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - NODE_OPTIONS=--max-old-space-size=3072
    env_file:
      - .env
    command: ["sh", "-c", "node -e \"const fs=require('fs'),p='/home/node/.openclaw/agents',src=p+'/main/agent/auth-profiles.json';if(fs.existsSync(src)){const d=fs.readFileSync(src,'utf8');fs.readdirSync(p).forEach(a=>{if(a==='main')return;const dir=p+'/'+a+'/agent',dest=dir+'/auth-profiles.json';if(!fs.existsSync(dest)){fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(dest,d);console.log('auth-profiles propagated to '+a)}})}\" 2>/dev/null; exec node openclaw.mjs gateway --bind lan --port 18789 --allow-unconfigured"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18789/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    mem_limit: 4g
    pids_limit: 256

  openclaw-workers:
    image: ssdavidai00/alfred-openclaw:latest
    depends_on:
      init:
        condition: service_completed_successfully
      temporal:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/openclaw-workers:/home/node/.openclaw
      - /mnt/encrypted/openclaw-workers/qmd-cache:/home/node/.cache/qmd
      - /mnt/encrypted/vault:/home/node/.openclaw/workspace/vault
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
    tmpfs:
      - /tmp:size=256m
    environment:
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - NODE_OPTIONS=--max-old-space-size=3072
    env_file:
      - .env
    command: ["node", "openclaw.mjs", "gateway", "--bind", "lan", "--port", "18790", "--allow-unconfigured"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18790/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
    mem_limit: 4g
    pids_limit: 256

  alfred:
    image: ssdavidai00/alfred-worker:latest
    depends_on:
      openclaw-workers:
        condition: service_healthy
      ctrl-api:
        condition: service_healthy
      init:
        condition: service_completed_successfully
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/app/data
      - /mnt/encrypted/openclaw-workers:/root/.openclaw
    tmpfs:
      - /tmp:size=256m
    environment:
      - OPENCLAW_GATEWAY_URL=http://openclaw-workers:18790
      - ALFRED_CTRL_URL=http://ctrl-api:3100
    env_file:
      - .env
    entrypoint: ["bash", "-c", "rm -f /app/data/alfred.pid && set -a && [ -f /app/data/.env ] && source /app/data/.env; [ -f /app/data/.gateway-token ] && export OPENCLAW_GATEWAY_TOKEN=$(cat /app/data/.gateway-token); set +a && exec alfred --config /app/data/config.yaml up --foreground"]
    command: []
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - DAC_OVERRIDE
      - FOWNER
      - CHOWN
    mem_limit: 2g
    pids_limit: 256

  ctrl-api:
    image: node:22-slim
    depends_on:
      init:
        condition: service_completed_successfully
    volumes:
      - /opt/alfred/api.mjs:/app/api.mjs:ro
      - /opt/alfred:/opt/alfred
      - /mnt/encrypted/vault:/mnt/encrypted/vault
      - /mnt/encrypted/alfred:/mnt/encrypted/alfred
      - /mnt/encrypted/openclaw:/mnt/encrypted/openclaw
      - /mnt/encrypted/openclaw-workers:/mnt/encrypted/openclaw-workers
      - /opt/alfred/compose:/opt/alfred/compose
      - /var/run/docker.sock:/var/run/docker.sock
      - /usr/bin/docker:/usr/bin/docker:ro
      - /usr/libexec/docker/cli-plugins:/usr/libexec/docker/cli-plugins:ro
    working_dir: /opt/alfred/compose
    command: ["bash", "-c", "apt-get update -qq && apt-get install -y -qq procps jq curl python3-yaml >/dev/null 2>&1; exec node --max-old-space-size=768 /app/api.mjs"]
    env_file:
      - .env
    environment:
      - AAS_HOST=0.0.0.0
      - AAS_PORT=3100
      - NODE_ENV=production
      # AgentMail channels/email inbound needs the openclaw gateway token to
      # spawn an agent session. The file lives on the shared /mnt/encrypted/alfred
      # mount (same path inside this container — we don't remap to /alfred-data
      # here like alfred-learn does).
      - OPENCLAW_GATEWAY_TOKEN_FILE=/mnt/encrypted/alfred/.gateway-token
    ports:
      - "127.0.0.1:3100:3100"
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:3100/api/v1/learning/status -H \"Authorization: Bearer $AAS_API_KEY\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    mem_limit: 1g
    pids_limit: 256

  alfred-learn:
    image: ssdavidai00/alfred-learn:latest
    depends_on:
      temporal:
        condition: service_healthy
      openclaw-workers:
        condition: service_healthy
      ctrl-api:
        condition: service_healthy
    volumes:
      - /mnt/encrypted/vault:/vault
      - /mnt/encrypted/alfred:/alfred-data
      - /mnt/encrypted/openclaw-workers:/openclaw-workers-state
    environment:
      - TEMPORAL_HOST=temporal:7233
      - OPENCLAW_GATEWAY_URL=http://openclaw-workers:18790
      - OPENCLAW_GATEWAY_TOKEN_FILE=/alfred-data/.gateway-token
      - VAULT_PATH=/vault
      - TASK_QUEUE=alfred-learn
      - ALFRED_LEARN_ENABLED=${ALFRED_LEARN_ENABLED:-true}
      - ALFRED_CTRL_URL=http://ctrl-api:3100
      - SAAS_API_URL=https://alfred.black
      - WORKERS_OPENCLAW_CONFIG=/openclaw-workers-state/openclaw.json
      - EXECUTION_GATEWAY_URL=http://openclaw-workers:18790
    env_file:
      - .env
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: 4g
    pids_limit: 128

{% if plane_enabled %}
  # ── Plane self-hosted PM (stable) ───────────────────────────────────
  # Opt-in sidecar stack (see issue #536). All services bind to the internal
  # compose network; external reach-in is only via plane-proxy:8080 which the
  # provisioner's setup_plane step then talks to over localhost.
  #
  # Secrets (DJANGO_SECRET_KEY, REDIS_PASSWORD, POSTGRES_PASSWORD,
  # MINIO_ROOT_PASSWORD, PLANE_WEBHOOK_SECRET, PLANE_ADMIN_EMAIL,
  # PLANE_ADMIN_PASSWORD, PLANE_API_TOKEN, PLANE_WORKSPACE_SLUG,
  # PLANE_ALFRED_USER_ID) all live in /opt/alfred/compose/.env — generated by
  # the provisioner post-boot, never in cloud-init. Interpolated here via
  # docker compose's ${VAR} syntax from env_file.

  plane-db:
    image: postgres:15.7-alpine
    restart: unless-stopped
    environment:
      - POSTGRES_DB=plane
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - PGDATA=/var/lib/postgresql/data
    volumes:
      - /mnt/encrypted/plane/pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U plane -d plane"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 1g
    pids_limit: 256

  plane-redis:
    image: valkey/valkey:7.2.11-alpine
    restart: unless-stopped
    command: ["valkey-server", "--requirepass", "${REDIS_PASSWORD}", "--appendonly", "yes"]
    volumes:
      - /mnt/encrypted/plane/redis:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli -a ${REDIS_PASSWORD} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 15s
    mem_limit: 256m
    pids_limit: 128

  plane-mq:
    image: rabbitmq:3.13-management-alpine
    restart: unless-stopped
    environment:
      - RABBITMQ_DEFAULT_USER=plane
      - RABBITMQ_DEFAULT_PASS=${REDIS_PASSWORD}
      - RABBITMQ_DEFAULT_VHOST=plane
    volumes:
      - /mnt/encrypted/plane/rabbitmq:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD-SHELL", "rabbitmq-diagnostics -q ping"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 30s
    mem_limit: 512m
    pids_limit: 256

  plane-minio:
    image: minio/minio:latest
    restart: unless-stopped
    command: ["server", "/export", "--console-address", ":9090"]
    environment:
      - MINIO_ROOT_USER=plane
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
    volumes:
      - /mnt/encrypted/plane/uploads:/export
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/minio/health/live || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 30s
    mem_limit: 256m
    pids_limit: 128

  plane-api:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-db:
        condition: service_healthy
      plane-redis:
        condition: service_healthy
      plane-mq:
        condition: service_healthy
      plane-minio:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - POSTGRES_HOST=plane-db
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
      - USE_MINIO=1
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_S3_BUCKET_NAME=uploads
      - AWS_REGION=us-east-1
      - WEB_URL=http://plane-proxy:8080
      - ENABLE_SIGNUP=0
      - ENABLE_EMAIL_PASSWORD=1
      - ENABLE_MAGIC_LINK_LOGIN=0
      - API_KEY_RATE_LIMIT=600/minute
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-api.sh"]
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:8000/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 120s
    mem_limit: 1g
    pids_limit: 256

  plane-worker:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_HOST=plane-db
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
      - USE_MINIO=1
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_S3_BUCKET_NAME=uploads
      - AWS_REGION=us-east-1
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-worker.sh"]
    mem_limit: 1g
    pids_limit: 256

  plane-beat:
    image: makeplane/plane-backend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=plane.settings.production
      - DEBUG=0
      - SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db:5432/plane
      - POSTGRES_HOST=plane-db
      - POSTGRES_USER=plane
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=plane
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
      - REDIS_HOST=plane-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - AMQP_URL=amqp://plane:${REDIS_PASSWORD}@plane-mq:5672/plane
    command: ["/bin/sh", "-c", "./bin/docker-entrypoint-beat.sh"]
    mem_limit: 256m
    pids_limit: 128

  plane-web:
    image: makeplane/plane-frontend:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    command: ["node", "web/server.js"]
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000 >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    mem_limit: 512m
    pids_limit: 256

  plane-space:
    image: makeplane/plane-space:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    command: ["node", "space/server.js"]
    mem_limit: 256m
    pids_limit: 128

  plane-admin:
    image: makeplane/plane-admin:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - NEXT_PUBLIC_API_BASE_URL=
      - NEXT_PUBLIC_DEPLOY_URL=
    command: ["node", "admin/server.js"]
    mem_limit: 256m
    pids_limit: 128

  plane-live:
    image: makeplane/plane-live:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
    environment:
      - API_BASE_URL=http://plane-api:8000
      - LIVE_BASE_PATH=/live
      - REDIS_URL=redis://:${REDIS_PASSWORD}@plane-redis:6379/0
    mem_limit: 256m
    pids_limit: 128

  plane-proxy:
    image: makeplane/plane-proxy:stable
    restart: unless-stopped
    depends_on:
      plane-api:
        condition: service_healthy
      plane-web:
        condition: service_healthy
    ports:
      - "127.0.0.1:8080:80"
    environment:
      - FILE_SIZE_LIMIT=5242880
      - BUCKET_NAME=uploads
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:80/ >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    mem_limit: 64m
    pids_limit: 128
{% endif %}

volumes: {}
